---
interface ServiceOption {
  id: string;
  title: string;
}

interface Props {
  services: ServiceOption[];
  whatsappRaw?: string;
}

const { services = [], whatsappRaw = '905537331201' } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '8f075204-928b-4b2a-aa3e-79c99620b0ac';
const webhookUrl = import.meta.env.PUBLIC_WHATSAPP_WEBHOOK_URL || '';
const callmebotKey = import.meta.env.PUBLIC_CALLMEBOT_API_KEY || '';
const callmebotPhone = import.meta.env.PUBLIC_CALLMEBOT_PHONE || whatsappRaw;
---

<div id="contact-form-container" class="relative">
  <!-- Hata Bildirimi (Gizli) -->
  <div id="form-error-alert" class="hidden mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-xs font-semibold text-red-700 flex items-center gap-2">
    <svg class="w-4 h-4 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <span id="form-error-text">Bir hata oluştu, lütfen zorunlu alanları doldurunuz.</span>
  </div>

  <!-- Ana Form -->
  <form
    id="main-contact-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    class="space-y-4"
  >
    <!-- Web3Forms Konfigürasyonu -->
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Kale İklimlendirme — Yeni Keşif Talebi" />
    <input type="hidden" name="from_name" value="Kale İklimlendirme Web Formu" />
    <!-- Bot Koruma (Honeypot) -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="form-name" class="block text-xs font-semibold text-navy-900 mb-1.5">
          Adınız Soyadınız <span class="text-red-500">*</span>
        </label>
        <input
          id="form-name"
          name="name"
          type="text"
          required
          placeholder="Örn: Ahmet Yılmaz"
          class="flex h-11 w-full rounded-xl border border-input bg-background px-4 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        />
      </div>

      <div>
        <label for="form-phone" class="block text-xs font-semibold text-navy-900 mb-1.5">
          Telefon Numaranız <span class="text-red-500">*</span>
        </label>
        <input
          id="form-phone"
          name="phone"
          type="tel"
          required
          placeholder="05XX XXX XX XX"
          class="flex h-11 w-full rounded-xl border border-input bg-background px-4 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="form-email" class="block text-xs font-semibold text-navy-900 mb-1.5">
          E-Posta Adresiniz (Opsiyonel)
        </label>
        <input
          id="form-email"
          name="email"
          type="email"
          placeholder="ornek@firma.com"
          class="flex h-11 w-full rounded-xl border border-input bg-background px-4 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        />
      </div>

      <div>
        <label for="form-service" class="block text-xs font-semibold text-navy-900 mb-1.5">
          İlgilendiğiniz Hizmet <span class="text-red-500">*</span>
        </label>
        <select
          id="form-service"
          name="service"
          required
          class="flex h-11 w-full rounded-xl border border-input bg-background px-4 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        >
          <option value="">Lütfen seçiniz</option>
          {services.map((s) => (
            <option value={s.title}>{s.title}</option>
          ))}
        </select>
      </div>
    </div>

    <div>
      <label for="form-message" class="block text-xs font-semibold text-navy-900 mb-1.5">
        Proje / Talep Detayları
      </label>
      <textarea
        id="form-message"
        name="message"
        rows="4"
        placeholder="Mekan türü (ev, ofis, otel, fabrika, UPS odası), yaklaşık m² veya arıza detayını belirtiniz..."
        class="flex w-full rounded-xl border border-input bg-background px-4 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
      ></textarea>
    </div>

    <button
      id="form-submit-btn"
      type="submit"
      class="w-full h-12 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-bold text-base shadow-md cursor-pointer transition-all flex items-center justify-center gap-2"
    >
      <span id="btn-text">Ücretsiz Keşif Talebini Gönder</span>
      <span id="btn-spinner" class="hidden flex items-center gap-2">
        <svg class="h-5 w-5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Talebiniz İletiliyor...</span>
      </span>
    </button>
  </form>

  <!-- Başarı Ekranı (İlk başta gizli) -->
  <div id="form-success-card" class="hidden rounded-2xl bg-surface border border-emerald-500/30 p-8 sm:p-10 text-center space-y-5">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 shadow-xs">
      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <div class="space-y-2">
      <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider">
        Talebiniz Alındı
      </span>
      <h3 class="text-2xl font-bold text-navy-950 font-heading">
        Keşif Talebiniz Başarıyla İletildi!
      </h3>
      <p class="text-sm text-gray-600 max-w-md mx-auto leading-relaxed">
        Sayın <strong id="success-customer-name">Değerli Müşterimiz</strong>, talebiniz yetkili mühendislik ekibimize ulaştı.
        En geç 1 iş saati içerisinde belirttiğiniz telefon numarasından sizinle iletişime geçeceğiz.
      </p>
    </div>

    <div class="pt-3">
      <button
        id="form-reset-btn"
        type="button"
        class="h-11 px-6 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-navy-900 font-semibold text-sm shadow-xs transition-colors cursor-pointer"
      >
        Yeni Talep Gönder
      </button>
    </div>
  </div>
</div>

<script define:vars={{ webhookUrl, callmebotKey, callmebotPhone }}>
  document.addEventListener('DOMContentLoaded', () => {
    // URL'de kalmış ?name=... parametrelerini anında temizle
    if (window.location.search) {
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    const form = document.getElementById('main-contact-form');
    const submitBtn = document.getElementById('form-submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const successCard = document.getElementById('form-success-card');
    const errorAlert = document.getElementById('form-error-alert');
    const errorText = document.getElementById('form-error-text');
    const resetBtn = document.getElementById('form-reset-btn');
    const customerNameEl = document.getElementById('success-customer-name');

    if (!form || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('form-name');
      const phoneInput = document.getElementById('form-phone');
      const serviceSelect = document.getElementById('form-service');
      const emailInput = document.getElementById('form-email');
      const messageInput = document.getElementById('form-message');

      const name = nameInput?.value?.trim() || '';
      const phone = phoneInput?.value?.trim() || '';
      const service = serviceSelect?.value || '';
      const email = emailInput?.value?.trim() || 'Belirtilmedi';
      const message = messageInput?.value?.trim() || 'Detay belirtilmedi';

      // Doğrulama kontrolü
      if (!name || !phone || !service) {
        errorAlert?.classList.remove('hidden');
        if (errorText) errorText.textContent = 'Lütfen zorunlu alanları (Ad Soyad, Telefon, Hizmet) eksiksiz doldurunuz.';
        return;
      }

      // Buton yükleniyor durumuna geçer
      errorAlert?.classList.add('hidden');
      submitBtn.disabled = true;
      btnText?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');

      const formData = new FormData(form);

      // Formatlanmış WhatsApp mesajı hazırla
      const waText = [
        '*KALE İKLİMLENDİRME — YENİ KEŞİF & TEKLİF TALEBİ* ❄️',
        '━━━━━━━━━━━━━━━━━━━━━━━━━',
        `👤 *Müşteri:* ${name}`,
        `📞 *Telefon:* ${phone}`,
        `📧 *E-Posta:* ${email}`,
        `🛠️ *İlgilenilen Hizmet:* ${service}`,
        `📝 *Talep / Detay:* ${message}`,
        '━━━━━━━━━━━━━━━━━━━━━━━━━',
        '_kaleiklimlendirme.com web iletişim formundan iletilmiştir._'
      ].join('\n');

      formData.append('whatsapp_ozeti', waText);

      // Arka plan bildirimleri
      if (callmebotKey && callmebotPhone) {
        const cbUrl = `https://api.callmebot.com/whatsapp.php?phone=${encodeURIComponent(callmebotPhone)}&text=${encodeURIComponent(waText)}&apikey=${encodeURIComponent(callmebotKey)}`;
        fetch(cbUrl, { mode: 'no-cors' }).catch(() => {});
      }

      if (webhookUrl) {
        fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, service, message, whatsappText: waText })
        }).catch(() => {});
      }

      // Web3Forms E-Posta Gönderimi
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json().catch(() => ({ success: true }));
        console.log('[Web3Forms Gönderim Sonucu]:', result);

        if (response.ok || result.success) {
          // Başarı ekranını göster
          if (customerNameEl) customerNameEl.textContent = name;
          form.classList.add('hidden');
          successCard?.classList.remove('hidden');
        } else {
          errorAlert?.classList.remove('hidden');
          if (errorText) errorText.textContent = result.message || 'Gönderim sırasında bir hata oluştu, lütfen bizi doğrudan arayınız.';
          submitBtn.disabled = false;
          btnText?.classList.remove('hidden');
          btnSpinner?.classList.add('hidden');
        }
      } catch (err) {
        console.warn('[Çevrimdışı/Hata]:', err);
        // Kullanıcıya her durumda olumlu onay göster
        if (customerNameEl) customerNameEl.textContent = name;
        form.classList.add('hidden');
        successCard?.classList.remove('hidden');
      }
    });

    // Yeni talep gönder butonuna basıldığında formu sıfırla
    resetBtn?.addEventListener('click', () => {
      form.reset();
      submitBtn.disabled = false;
      btnText?.classList.remove('hidden');
      btnSpinner?.classList.add('hidden');
      successCard?.classList.add('hidden');
      form.classList.remove('hidden');
      errorAlert?.classList.add('hidden');
    });
  });
</script>

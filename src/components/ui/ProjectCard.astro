---
import { Badge } from '@/components/ui/badge';

interface Props {
  title: string;
  client: string;
  location: string;
  systemType: string;
  summary: string;
  slug: string;
}

const { title, client, location, systemType, summary, slug } = Astro.props;
---

<article class="flex flex-col justify-between rounded-2xl border border-gray-200 bg-surface p-6 sm:p-7 transition-all duration-200 hover:border-brand-500/40 hover:shadow-md">
  <div>
    <!-- Metadata Bar -->
    <div class="mb-3.5 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-500">
      <Badge variant="brand" className="font-semibold">
        {client}
      </Badge>
      <span class="flex items-center gap-1 font-medium">
        <svg class="h-3.5 w-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {location}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold leading-snug text-navy-900">
      <a href={`/projeler/${slug}`} class="hover:text-brand-600 transition-colors focus:outline-none">
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="mt-3 text-sm leading-relaxed text-gray-600">
      {summary}
    </p>
  </div>

  <!-- Footer Specs -->
  <footer class="mt-6 flex items-center justify-between border-t border-gray-200 pt-4 text-xs font-medium text-gray-500">
    <span>
      Sistem: <strong class="text-navy-900 font-semibold">{systemType}</strong>
    </span>
    <a
      href={`/projeler/${slug}`}
      class="inline-flex items-center gap-1 font-bold text-brand-600 hover:text-brand-700 transition-colors"
      aria-label={`${title} projesini detaylı inceleyin`}
    >
      <span>İncele</span>
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </footer>
</article>

---
interface Props {
  title: string;
  client: string;
  location: string;
  systemType: string;
  summary: string;
  slug: string;
  coverImage?: string;
}

const { title, client, location, systemType, summary, slug, coverImage } = Astro.props;
---

<article class="group flex flex-col justify-between rounded-xl border border-gray-200 bg-white p-5 sm:p-6 transition-all duration-200 hover:border-brand-500/40 hover:shadow-md h-full">
  <div>
    <!-- Cover Image Thumbnail (Temiz, görseli kapatmayan yapı) -->
    {coverImage && (
      <a
        href={`/projeler/${slug}/`}
        title={`${title} - Referans Proje İncelemesi`}
        class="relative block overflow-hidden rounded-lg mb-4 aspect-[16/10] bg-navy-950/10 group/img"
      >
        <img
          src={coverImage}
          alt={title}
          width="600"
          height="375"
          class="w-full h-full object-cover object-center transition-transform duration-300 group-hover/img:scale-105"
          loading="lazy"
        />
      </a>
    )}

    <!-- Konum Bilgisi (Nitelikli konut vb. başlık kaldırıldı, yerine doğrudan konum rozeti yerleştirildi) -->
    <div class="mb-3">
      <span class="inline-flex items-center gap-1.5 font-semibold text-xs text-brand-700 bg-brand-50 border border-brand-500/20 px-2.5 py-1 rounded-md">
        <svg class="h-3.5 w-3.5 text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{location}</span>
      </span>
    </div>

    <!-- Başlık (Tam metin, kesilme yok) -->
    <h3 class="text-base sm:text-lg font-bold leading-snug text-navy-950">
      <a
        href={`/projeler/${slug}/`}
        title={`${title} - Proje Detayları ve Uygulama Aşamaları`}
        class="hover:text-brand-600 transition-colors focus:outline-none"
      >
        {title}
      </a>
    </h3>

    <!-- Özet Açıklama (Kesilmeden tam cümle) -->
    <p class="mt-2.5 text-sm leading-relaxed text-gray-600">
      {summary}
    </p>
  </div>

  <!-- Footer Specs (Kesilme olmadan tam gösterim) -->
  <footer class="mt-5 pt-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs">
    <div class="text-gray-600 leading-relaxed">
      Sistem: <strong class="text-navy-950 font-semibold">{systemType}</strong>
    </div>
    <a
      href={`/projeler/${slug}/`}
      title={`${title} Projesini Detaylı İnceleyin`}
      class="inline-flex items-center gap-1 font-bold text-brand-600 hover:text-brand-700 transition-colors shrink-0 self-end sm:self-center ml-auto"
      aria-label={`${title} projesini detaylı inceleyin`}
    >
      <span>İncele</span>
      <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </footer>
</article>

---
interface Props {
  title: string;
  shortDescription: string;
  slug: string;
  icon?: string;
}

const { title, shortDescription, slug, icon = 'fan' } = Astro.props;
---

<article class="group flex flex-col justify-between rounded-2xl border border-surface-border bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-brand-500/40 hover:shadow-md">
  <div>
    <!-- Icon Container -->
    <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-500 group-hover:text-white" aria-hidden="true">
      {icon === 'building' ? (
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
      ) : icon === 'wrench' ? (
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />
        </svg>
      ) : icon === 'pipes' ? (
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8m-5 5h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293h3.172a1 1 0 00.707-.293l2.414-2.414a1 1 0 01.707-.293H20" />
        </svg>
      ) : (
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
          <circle cx="12" cy="12" r="3" stroke-width="2" />
        </svg>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-lg font-bold text-navy-900 transition-colors group-hover:text-brand-600">
      <a href={`/hizmetler/${slug}`} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <p class="mt-2.5 text-sm leading-relaxed text-gray-600">
      {shortDescription}
    </p>
  </div>

  <!-- Footer Link -->
  <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-4">
    <a
      href={`/hizmetler/${slug}`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-navy-900 transition-colors group-hover:text-brand-600"
      aria-label={`${title} hakkında detaylı bilgi alın`}
    >
      <span>Detaylı Bilgi</span>
      <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a
      href="/iletisim"
      class="rounded-lg border border-gray-200 bg-surface px-2.5 py-1 text-[11px] font-semibold text-gray-700 transition-colors hover:border-brand-500 hover:text-brand-600"
    >
      Keşif İste
    </a>
  </div>
</article>

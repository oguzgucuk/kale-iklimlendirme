---
interface Props {
  title: string;
  shortDescription: string;
  slug: string;
  icon?: string;
}

const { title, shortDescription, slug, icon = 'fan' } = Astro.props;
---

<article class="group flex flex-col justify-between rounded-lg border border-gray-200 bg-white p-6 shadow-xs transition-all duration-200 hover:border-brand-500/40 hover:shadow-sm">
  <div>
    <!-- Title -->
    <h3 class="text-lg font-bold text-navy-950 transition-colors group-hover:text-brand-600">
      <a href={`/hizmetler/${slug}/`} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <p class="mt-2.5 text-sm leading-relaxed text-slate-600">
      {shortDescription}
    </p>
  </div>

  <!-- Footer Link -->
  <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-4">
    <a
      href={`/hizmetler/${slug}/`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-navy-950 transition-colors group-hover:text-brand-600"
      aria-label={`${title} hakkında detaylı bilgi alın`}
    >
      <span>Detaylı Bilgi</span>
      <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a
      href="/iletisim/"
      class="rounded-md border border-gray-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 transition-colors hover:border-brand-500 hover:text-brand-600"
    >
      Keşif İste
    </a>
  </div>
</article>

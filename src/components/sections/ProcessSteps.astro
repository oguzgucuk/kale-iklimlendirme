---
const steps = [
  {
    step: '01',
    title: 'Ücretsiz Keşif & Talep',
    description: 'Mekanınızı yerinde ziyaret ediyor, ısı kayıplarını ve mimari borulama güzergahlarını inceliyoruz.',
  },
  {
    step: '02',
    title: 'Mühendislik & Teklif',
    description: 'VRF / klima kapasite hesaplarını mühendislik yazılımlarıyla çıkarıp alternatifli şeffaf teklif sunuyoruz.',
  },
  {
    step: '03',
    title: 'Sertifikalı Montaj & Test',
    description: 'Azot basınç ve vakum testlerinin ardından sistemi üretici standartlarında çalışır vaziyette teslim ediyoruz.',
  },
  {
    step: '04',
    title: '7/24 Servis & Bakım',
    description: 'Düzenli periyodik hijyenik bakım sözleşmeleri ve acil arıza desteği ile cihaz ömrünü koruyoruz.',
  },
];
---

<section class="py-14 sm:py-20 bg-surface border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
        Çalışma Modelimiz
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-900 mt-1.5 leading-tight">
        4 Adımda Kusursuz İklimlendirme Süreci
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-2.5 leading-relaxed">
        Projelerimizi ilk keşif aşamasından periyodik bakıma kadar adım adım şeffaf ve profesyonel olarak yürütüyoruz.
      </p>
    </header>

    <!-- Semantic Ordered List: ol / li -->
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 list-none p-0 m-0">
      {steps.map((item) => (
        <li class="relative flex flex-col justify-between rounded-2xl border border-gray-200/90 bg-white p-6 shadow-sm">
          <div>
            <!-- Step Number Badge -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl font-black text-brand-500 font-mono tracking-wider">
                {item.step}
              </span>
              <span class="h-2 w-2 rounded-full bg-brand-200"></span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-navy-900 leading-snug">
              {item.title}
            </h3>

            <p class="mt-2 text-xs sm:text-sm text-gray-600 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-5 pt-3 border-t border-gray-100 flex items-center gap-1.5 text-[11px] font-semibold text-brand-600">
            <span>Standart Süreç</span>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

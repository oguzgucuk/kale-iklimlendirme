---
const steps = [
  {
    phase: '01',
    title: 'Yerinde Keşif & Yük Hesabı',
    description: 'Mekanınızı yerinde ziyaret ediyor, ısı kayıp ve kazançlarını hesaplayarak mimari borulama güzergahlarını belirliyoruz.',
  },
  {
    phase: '02',
    title: 'Mühendislik & Şeffaf Proje',
    description: 'VRF ve multi sistem kapasite seçimlerini simülasyon yazılımlarıyla modelleyip alternatifli teknik teklif sunuyoruz.',
  },
  {
    phase: '03',
    title: 'Azot Testli Sertifikalı Montaj',
    description: '40 bar azot sızdırmazlık testi ve çift kademeli derin vakum uygulayarak sistemi fabrika standartlarında kuruyoruz.',
  },
  {
    phase: '04',
    title: 'Devreye Alma & Garanti',
    description: 'Performans ve hava debisi ölçümlerinin ardından resmi garanti belgeleri ve periyodik bakım takvimiyle teslim ediyoruz.',
  },
];
---

<section class="py-16 sm:py-24 bg-slate-50/70 border-t border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Left-aligned, architectural) -->
    <header class="max-w-3xl mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-950 tracking-tight leading-tight font-heading">
        Mühendislik Proje ve Teslim Süreci
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2.5 leading-relaxed font-normal">
        İlk keşif randevusundan anahtar teslim devreye almaya kadar her aşamada şeffaf, ölçülebilir ve garantili çalışma modeli.
      </p>
    </header>

    <!-- Engineering Milestone Timeline: 4 connected phases -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((item, idx) => (
        <div class="relative flex flex-col justify-between rounded-xl border border-gray-200/90 bg-white p-6 shadow-xs transition-all hover:border-brand-500/40">
          <div>
            <!-- Top Step Indicator -->
            <div class="flex items-center justify-between pb-3.5 mb-3.5 border-b border-gray-100">
              <span class="text-xs font-mono font-bold text-brand-600 tracking-wider">
                FAZ {item.phase}
              </span>
              <span class="text-[11px] font-semibold text-slate-400">
                Aşama {idx + 1}/4
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-navy-950 leading-snug font-heading">
              {item.title}
            </h3>

            <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-gray-100 flex items-center gap-1.5 text-[11px] font-semibold text-slate-500">
            <svg class="h-3.5 w-3.5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Doğrulanmış Prosedür</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

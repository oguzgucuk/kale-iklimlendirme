---
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
}

const { testimonials } = Astro.props;
---

<section class="py-14 sm:py-20 bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
        Müşteri Memnuniyeti
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-900 mt-1.5 leading-tight">
        Bizi Tercih Edenlerin Deneyimleri
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-2.5 leading-relaxed">
        Plaza yöneticilerinden mimari danışmanlara kadar iş ortaklarımızın projelerimiz hakkındaki yorumları.
      </p>
    </header>

    <!-- Semantic Figures Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {testimonials.map((t) => (
        <figure class="flex flex-col justify-between rounded-2xl border border-gray-200 bg-surface p-6 sm:p-7 shadow-sm">
          <div>
            <!-- 5-Star Rating SVG Display -->
            <div class="flex items-center gap-1 text-amber-400 mb-4" aria-label={`Puan: ${t.data.rating} / 5`}>
              {Array.from({ length: t.data.rating }).map(() => (
                <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <blockquote class="text-sm leading-relaxed text-gray-700 italic">
              "{t.data.quote}"
            </blockquote>
          </div>

          <figcaption class="mt-6 border-t border-gray-200 pt-4 flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-navy-900 text-brand-400 font-bold flex items-center justify-center text-sm shrink-0">
              {t.data.authorName.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-bold text-navy-900">{t.data.authorName}</div>
              <div class="text-xs text-gray-500 font-medium">{t.data.authorRole}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>

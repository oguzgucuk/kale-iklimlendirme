---
import company from '@/data_files/company.json';

const { className = '' } = Astro.props;

const trustPoints = [
  {
    title: 'Orijinal Parça & Garantili Montaj',
    description:
      'Tüm sistem kurulumlarında ve onarımlarında üretici standartlarında sertifikalı parçalar ve kaliteli bakır borulama tesisatı kullanılır.',
  },
  {
    icon: 'wrench',
    title: '7/24 Kesintisiz Acil Müdahale',
    description:
      'Otel, hastane, plaza ve iş merkezleri gibi kritik işletmeler için nöbetçi teknik servis ekiplerimiz haftanın her günü görev başındadır.',
  },
  {
    icon: 'chart',
    title: 'Ücretsiz Mühendislik Keşfi',
    description:
      'Doğru kapasite analizi ile mekanınıza uygun VRF veya split klima projesini gereksiz enerji sarfiyatını önleyecek şekilde projelendiriyoruz.',
  },
  {
    icon: 'shield-check',
    title: 'İşçilik & Kurulum Garantisi',
    description:
      'Tamamladığımız tüm mekanik tesisat ve cihaz montajı uygulamalarımız resmi servis ve işçilik garantisi altındadır.',
  },
];
---

<section class={`py-16 sm:py-24 bg-white border-b border-gray-100 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- Left Column: Big Narrative (5 cols on lg) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
            Neden Kale İklimlendirme?
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-900 tracking-tight mt-2 leading-tight">
            Mühendislik Hassasiyeti, Doğru Kapasite Hesabı.
          </h2>
        </div>

        <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
          Yanlış seçilen bir klima sistemi yüksek elektrik faturalarına ve yetersiz soğutmaya yol açar. 
          Uzman ekibimizle sadece cihaz satmıyor, binanızın mimari yapısına en uygun iklimlendirme altyapısını kuruyoruz.
        </p>

        <!-- Authorized Brands Showcase -->
        <div class="pt-4 border-t border-gray-100">
          <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-3">
            Satış ve Montajını Yaptığımız Markalar
          </span>
          <div class="flex flex-wrap gap-2">
            {company.authorizedBrands.map((brand) => (
              <span class="inline-flex items-center px-3 py-1.5 rounded-lg bg-surface text-xs font-bold text-navy-900 border border-gray-200 shadow-sm">
                {brand}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: 4 Trust Points List (7 cols on lg) -->
      <div class="lg:col-span-7">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5 list-none p-0 m-0">
          {trustPoints.map((point, index) => (
            <li class="rounded-2xl border border-gray-200 bg-surface p-5 sm:p-6 transition-all hover:border-brand-500/40">
              <div class="flex items-center gap-3 mb-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-500 text-xs font-bold text-white shrink-0">
                  0{index + 1}
                </span>
                <h3 class="text-base font-bold text-navy-900 leading-snug">
                  {point.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed pl-10">
                {point.description}
              </p>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

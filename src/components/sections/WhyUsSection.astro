---
import company from '@/data_files/company.json';

const trustPoints = [
  {
    title: 'Hatasız Mühendislik & Kapasite Hesabı',
    description: 'Ezbere değil; mekanın cephe yönü, cam geçirgenliği ve ısı kayıplarını hesaplayarak ideal BTU ve kW kapasitesini belirliyoruz.',
  },
  {
    title: 'Sertifikalı Basınç & Vakum Testi',
    description: 'Montaj öncesi tesisata 40 bar kuru azot basarak kaçak riskini sıfırlıyor, derin vakum ile kompresör ömrünü uzatıyoruz.',
  },
  {
    title: '7/24 Nöbetçi Teknik Servis',
    description: 'Server odaları, oteller ve işletmeler için kritik arıza anında hızlı yerinde müdahale sağlıyoruz.',
  },
  {
    title: 'Yetkili Distribütör & Orijinal Parça',
    description: 'Tüm sistem ve yedek parçalarda üretici garantili orijinal ürün kullanımını taahhüt ediyoruz.',
  },
];
---

<section class="py-14 sm:py-20 bg-white border-y border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Trust Summary & Authorized Brands (5 cols on lg) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
            Neden Kale İklimlendirme?
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-900 mt-1.5 leading-tight">
            Mühendislik Titizliği, Kesintisiz Konfor
          </h2>
          <p class="text-sm sm:text-base text-gray-600 mt-3 leading-relaxed">
            15 yılı aşkın süredir yalnızca klima montajı değil; yapıların estetiğini ve enerji bütçesini koruyan kalıcı iklimlendirme altyapıları inşa ediyoruz.
          </p>
        </div>

        <!-- Authorized Brands Showcase -->
        <div class="pt-4 border-t border-gray-100">
          <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-3">
            Yetkili Çözüm Ortaklarımız
          </span>
          <div class="flex flex-wrap gap-2">
            {company.authorizedBrands.map((brand) => (
              <span class="inline-flex items-center px-3 py-1.5 rounded-lg bg-surface text-xs font-bold text-navy-900 border border-gray-200 shadow-sm">
                {brand}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: 4 Trust Points List (7 cols on lg) -->
      <div class="lg:col-span-7">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5 list-none p-0 m-0">
          {trustPoints.map((point, index) => (
            <li class="rounded-2xl border border-gray-200 bg-surface p-5 sm:p-6 transition-all hover:border-brand-500/40">
              <div class="flex items-center gap-3 mb-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-500 text-xs font-bold text-white shrink-0">
                  0{index + 1}
                </span>
                <h3 class="text-base font-bold text-navy-900 leading-snug">
                  {point.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed pl-10">
                {point.description}
              </p>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

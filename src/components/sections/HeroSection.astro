---
import company from '@/data_files/company.json';
import { FastQuoteModal } from '@/components/ui/FastQuoteModal';
import { HeroGallery } from '@/components/ui/HeroGallery';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const brands = [
  {
    name: 'Carrier',
    logo: '/images/brand/carrier.webp',
    alt: 'Carrier VRF ve Bireysel Klima Sistemleri',
  },
  {
    name: 'GREE',
    logo: '/images/brand/gree.svg',
    alt: 'Gree Klima ve İklimlendirme Sistemleri',
  },
  {
    name: 'LG',
    logo: '/images/brand/lg.png',
    alt: 'LG Multi V ve Inverter İklimlendirme Sistemleri',
  },
  {
    name: 'Midea',
    logo: '/images/brand/midea.webp',
    alt: 'Midea Ticari ve Bireysel Klimalar',
  },
  {
    name: 'Samsung',
    logo: '/images/brand/samsung.svg',
    alt: 'Samsung Klima Sistemleri',
  },
  {
    name: 'Daikin',
    logo: '/images/brand/daikin.webp',
    alt: 'Daikin VRV ve Inverter Klima Çözümleri',
  },
  {
    name: 'Arçelik',
    logo: '/images/brand/arcelik.webp',
    alt: 'Arçelik Kurumsal ve Bireysel İklimlendirme',
  },
  {
    name: 'Mitsubishi Electric',
    logo: '/images/brand/mitsubishi.png',
    alt: 'Mitsubishi Electric Klima Sistemleri',
  },
];
---

<section
  id="hero"
  class={`relative min-h-screen lg:h-screen flex flex-col justify-between overflow-hidden ${className}`}
>
  <!-- Tam Ekran Arka Plan Görseli (TCDD Haydarpaşa Çatı VRF Geniş Açı Gün Işığı & Mavi Gökyüzü) -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/hero-tcdd-fullscreen-daylight.jpg"
      alt="TCDD Haydarpaşa Çatı VRF Merkezi Sistem Tesisatı - Kale İklimlendirme"
      class="w-full h-full object-cover object-[center_30%]"
      fetchpriority="high"
      loading="eager"
    />
    
    <!-- Mimari Kontrast Gradyanları: Doğal mavi gökyüzünü kapatmaz, sol taraftaki metinleri jilet gibi okutur -->
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/92 via-navy-950/65 to-transparent lg:w-[65%]" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-transparent to-black/25" aria-hidden="true"></div>
  </div>

  <!-- Üst / Orta Gövde: Şeffaf Header Altında Ferah Yerleşim (pt-28 lg:pt-32) -->
  <div class="relative z-10 flex-1 flex items-center w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 pb-8">
    <div class="max-w-2xl space-y-5 sm:space-y-6">
      
      <!-- Mimari Alan Rozeti -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/10 backdrop-blur-sm text-brand-300 text-xs font-semibold tracking-wide border border-white/15">
        <span class="h-2 w-2 rounded-full bg-brand-400"></span>
        <span>Mühendislik & Kurumsal VRF İklimlendirme</span>
      </div>

      <!-- H1 Başlık (Plus Jakarta Sans fontu ile tok mimari tipografi) -->
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-[3.25rem] font-extrabold tracking-tight text-white leading-[1.12]">
        Klima Satışından <span class="text-brand-400">VRF Merkezi Sistem</span> Projelendirmeye Uçtan Uca Çözüm.
      </h1>

      <!-- Açıklama Metni -->
      <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal max-w-xl">
        Hastaneler, plazalar, kamu binaları ve nitelikli konut projelerinde doğru kapasite hesabı, 40 bar azot testli garantili borulama ve yetkili servis güvencesi.
      </p>

      <!-- Eylem Butonları -->
      <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-3">
        <FastQuoteModal client:load />

        <a
          href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-3 text-xs sm:text-sm font-bold text-white bg-[#25D366] hover:bg-[#20bd5a] rounded-lg shadow-sm transition-all gap-2"
        >
          <svg class="h-4.5 w-4.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.599 2.674-.7c.976.58 2.019.882 3.209.882h.001c3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.767-5.768zm3.366 8.163c-.141.397-.714.729-1.026.776-.29.043-.654.072-2.12-.533-1.875-.776-3.08-2.697-3.174-2.82-.093-.124-.764-1.018-.764-1.942 0-.923.483-1.378.654-1.564.171-.186.374-.233.499-.233.124 0 .249.002.358.007.115.006.269-.044.421.323.157.38.537 1.309.584 1.405.047.096.078.209.016.333-.063.125-.094.202-.187.311-.093.11-.197.246-.281.33-.094.094-.192.197-.082.386.11.189.489.808 1.05 1.307.722.643 1.33.842 1.519.935.188.094.3.078.411-.047.112-.125.48-559.608-.751.127-.192.256-.16.429-.096.173.064 1.096.517 1.284.611.188.094.313.141.359.219.047.078.047.452-.094.849zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.176L2 22l4.982-1.397A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
          <span>WhatsApp Keşif Hattı</span>
        </a>

        <a
          href={`tel:${company.phoneRaw}`}
          class="inline-flex items-center justify-center px-4 py-3 text-xs sm:text-sm font-bold text-white bg-white/10 hover:bg-white/20 rounded-lg border border-white/20 transition-all gap-2 backdrop-blur-xs"
        >
          <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{company.phone}</span>
        </a>
      </div>

      <!-- Mimari Metrik Çubuğu (Hairline zemin çizgili, koyu temaya uyumlu) -->
      <div class="pt-5 border-t border-white/15 max-w-xl">
        <div class="grid grid-cols-3 gap-2 divide-x divide-white/15">
          <div class="pr-2 text-left">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-brand-400 tracking-tight">15+ Yıl</div>
            <div class="text-[11px] sm:text-xs text-slate-300 font-medium mt-0.5">Sektörel Deneyim</div>
          </div>
          <div class="px-3 sm:px-4 text-left">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-white tracking-tight">450+</div>
            <div class="text-[11px] sm:text-xs text-slate-300 font-medium mt-0.5">Tamamlanan Proje</div>
          </div>
          <div class="pl-3 sm:pl-4 text-left">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-slate-200 tracking-tight">8 Marka</div>
            <div class="text-[11px] sm:text-xs text-slate-300 font-medium mt-0.5">Yetkili Çözüm Ortaklığı</div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Alt Kısım: Sağlam Bir Zemin Oluşturan Yetkili Çözüm Ortakları Şeridi -->
  <div class="relative z-10 w-full shrink-0 border-t border-white/10 bg-navy-950/85 backdrop-blur-md pt-2 pb-3 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-1.5 text-center">
      <span class="text-[10px] sm:text-[11px] font-extrabold text-slate-300 uppercase tracking-widest block">
        Yetkili Çözüm Ortakları
      </span>
    </div>

    <!-- Kayan Şerit -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative w-full overflow-hidden select-none pointer-events-none">
        <!-- Kenar Fade Gradyanları -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-28 bg-gradient-to-r from-navy-950/90 via-navy-950/50 to-transparent z-10" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-28 bg-gradient-to-l from-navy-950/90 via-navy-950/50 to-transparent z-10" aria-hidden="true"></div>

        <!-- Kayan Hat -->
        <div class="flex w-max items-center py-1">
          <!-- 1. Grup -->
          <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0 animate-marquee-right">
            {brands.map((brand) => (
              <div class="flex items-center justify-center shrink-0">
                <img
                  src={brand.logo}
                  alt={brand.alt}
                  class={`w-auto object-contain pointer-events-none select-none brightness-0 invert opacity-80 hover:opacity-100 transition-opacity ${
                    brand.name === 'Mitsubishi Electric'
                      ? 'h-6 sm:h-7 max-w-[125px]'
                      : brand.name === 'Carrier'
                      ? 'h-5 sm:h-6 max-w-[110px]'
                      : brand.name === 'LG'
                      ? 'h-5 sm:h-6 max-w-[70px]'
                      : brand.name === 'Arçelik'
                      ? 'h-5 sm:h-6 max-w-[105px]'
                      : 'h-4 sm:h-5 max-w-[95px]'
                  }`}
                  loading="lazy"
                />
              </div>
            ))}
          </div>

          <!-- 2. Grup -->
          <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0 animate-marquee-right" aria-hidden="true">
            {brands.map((brand) => (
              <div class="flex items-center justify-center shrink-0">
                <img
                  src={brand.logo}
                  alt={brand.alt}
                  class={`w-auto object-contain pointer-events-none select-none brightness-0 invert opacity-80 hover:opacity-100 transition-opacity ${
                    brand.name === 'Mitsubishi Electric'
                      ? 'h-6 sm:h-7 max-w-[125px]'
                      : brand.name === 'Carrier'
                      ? 'h-5 sm:h-6 max-w-[110px]'
                      : brand.name === 'LG'
                      ? 'h-5 sm:h-6 max-w-[70px]'
                      : brand.name === 'Arçelik'
                      ? 'h-5 sm:h-6 max-w-[105px]'
                      : 'h-4 sm:h-5 max-w-[95px]'
                  }`}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee-right {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-marquee-right {
    animation: marquee-right 30s linear infinite;
    will-change: transform;
  }
</style>

---
import company from '@/data_files/company.json';
import { FastQuoteModal } from '@/components/ui/FastQuoteModal';
import { HeroGallery } from '@/components/ui/HeroGallery';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const brands = [
  {
    name: 'Carrier',
    logo: '/images/brand/carrier.webp',
    alt: 'Carrier VRF ve Bireysel Klima Sistemleri',
  },
  {
    name: 'GREE',
    logo: '/images/brand/gree.svg',
    alt: 'Gree Klima ve İklimlendirme Sistemleri',
  },
  {
    name: 'LG',
    logo: '/images/brand/lg.png',
    alt: 'LG Multi V ve Inverter İklimlendirme Sistemleri',
  },
  {
    name: 'Midea',
    logo: '/images/brand/midea.webp',
    alt: 'Midea Ticari ve Bireysel Klimalar',
  },
  {
    name: 'Samsung',
    logo: '/images/brand/samsung.svg',
    alt: 'Samsung Klima Sistemleri',
  },
  {
    name: 'Daikin',
    logo: '/images/brand/daikin.webp',
    alt: 'Daikin VRV ve Inverter Klima Çözümleri',
  },
  {
    name: 'Arçelik',
    logo: '/images/brand/arcelik.webp',
    alt: 'Arçelik Kurumsal ve Bireysel İklimlendirme',
  },
  {
    name: 'Mitsubishi Electric',
    logo: '/images/brand/mitsubishi.png',
    alt: 'Mitsubishi Electric Klima Sistemleri',
  },
];
---

<section
  id="hero"
  class={`relative bg-gradient-to-b from-slate-50/90 via-white to-slate-50/70 border-b border-gray-200 overflow-hidden flex flex-col justify-between min-h-[calc(100dvh-4rem)] lg:h-[calc(100vh-4rem)] lg:max-h-[calc(100vh-4rem)] ${className}`}
>
  <!-- Hafif Mimari Arka Plan Atmosferi (Çiğ beyazlığı kırar) -->
  <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
    <div class="absolute top-0 right-1/4 w-[450px] h-[450px] bg-brand-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 left-10 w-[350px] h-[350px] bg-sky-500/5 rounded-full blur-3xl"></div>
  </div>

  <!-- Üst Kısım: 2 Sütunlu Dengeli Gövde -->
  <div class="relative z-10 flex-1 flex items-center min-h-0 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 lg:py-2">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center w-full">
      
      <!-- Sol Sütun: Başlık, Açıklama, Butonlar ve Panel -->
      <div class="lg:col-span-7 space-y-5 sm:space-y-6">
        
        <!-- H1 Başlık (Plus Jakarta Sans fontu ile tok mimari tipografi) -->
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-4xl xl:text-[2.85rem] font-extrabold tracking-tight text-navy-950 leading-[1.14]">
          Klima Satışından <span class="text-brand-600">VRF Merkezi Sistem</span> Projelendirmeye Uçtan Uca Çözüm.
        </h1>

        <!-- Açıklama Metni -->
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-xl font-normal">
          Ev, ofis ve büyük ölçekli ticari binalar için doğru kapasite hesabı, garantili montaj, 
          7/24 kesintisiz arıza servisi ve periyodik hijyenik bakım hizmetleri.
        </p>

        <!-- Eylem Butonları -->
        <div class="pt-1.5 flex flex-col sm:flex-row sm:items-center gap-3">
          <FastQuoteModal client:load />

          <a
            href={`tel:${company.phoneRaw}`}
            class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 sm:py-3 text-xs sm:text-sm font-bold text-navy-950 bg-white hover:bg-slate-50 rounded-lg border border-gray-300 transition-all gap-2 shadow-xs"
          >
            <svg class="w-4 h-4 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Hemen Arayın: <strong>{company.phone}</strong></span>
          </a>
        </div>

        <!-- Mimari Metrik Çubuğu (Hairline zemin çizgili, kart içi kart hissini kırar) -->
        <div class="pt-4 border-t border-gray-200/80 max-w-xl">
          <div class="grid grid-cols-3 gap-2 divide-x divide-gray-200/80">
            <div class="pr-2 text-left">
              <div class="font-heading text-xl sm:text-2xl font-extrabold text-brand-600 tracking-tight">15+ Yıl</div>
              <div class="text-[11px] sm:text-xs text-slate-500 font-medium mt-0.5">Sektörel Deneyim</div>
            </div>
            <div class="px-3 sm:px-4 text-left">
              <div class="font-heading text-xl sm:text-2xl font-extrabold text-navy-950 tracking-tight">450+</div>
              <div class="text-[11px] sm:text-xs text-slate-500 font-medium mt-0.5">Tamamlanan Proje</div>
            </div>
            <div class="pl-3 sm:pl-4 text-left">
              <div class="font-heading text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">8 Marka</div>
              <div class="text-[11px] sm:text-xs text-slate-500 font-medium mt-0.5">Yetkili Çözüm Ortaklığı</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Sağ Sütun: İnteraktif Gerçek Saha Fotoğrafları Galerisi -->
      <div class="lg:col-span-5 w-full">
        <HeroGallery client:load />
      </div>

    </div>
  </div>

  <!-- Alt Kısım: Sağlam Bir Zemin Oluşturan Yetkili Çözüm Ortakları Şeridi -->
  <div class="relative z-10 w-full shrink-0 border-t border-gray-200/90 bg-slate-50/90 backdrop-blur-xs pt-2 pb-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-1.5 text-center">
      <span class="text-[10px] sm:text-[11px] font-extrabold text-gray-400 uppercase tracking-widest block">
        Yetkili Çözüm Ortakları
      </span>
    </div>

    <!-- Kayan Şerit -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative w-full overflow-hidden select-none pointer-events-none">
        <!-- Kenar Fade Gradyanları (Slate-50 tonuna uyumlu) -->
        <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-28 bg-gradient-to-r from-slate-50 via-slate-50/90 to-transparent z-10" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-28 bg-gradient-to-l from-slate-50 via-slate-50/90 to-transparent z-10" aria-hidden="true"></div>

        <!-- Kayan Hat -->
        <div class="flex w-max items-center py-0.5">
          <!-- 1. Grup -->
          <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0 animate-marquee-right">
            {brands.map((brand) => (
              <div class="flex items-center justify-center shrink-0">
                <img
                  src={brand.logo}
                  alt={brand.alt}
                  class={`w-auto object-contain pointer-events-none select-none ${
                    brand.name === 'Mitsubishi Electric'
                      ? 'h-6 sm:h-7 max-w-[125px]'
                      : brand.name === 'Carrier'
                      ? 'h-5 sm:h-6 max-w-[110px]'
                      : brand.name === 'LG'
                      ? 'h-5 sm:h-6 max-w-[70px]'
                      : brand.name === 'Arçelik'
                      ? 'h-5 sm:h-6 max-w-[105px]'
                      : 'h-4 sm:h-5 max-w-[95px]'
                  }`}
                  loading="lazy"
                />
              </div>
            ))}
          </div>

          <!-- 2. Grup -->
          <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0 animate-marquee-right" aria-hidden="true">
            {brands.map((brand) => (
              <div class="flex items-center justify-center shrink-0">
                <img
                  src={brand.logo}
                  alt={brand.alt}
                  class={`w-auto object-contain pointer-events-none select-none ${
                    brand.name === 'Mitsubishi Electric'
                      ? 'h-6 sm:h-7 max-w-[125px]'
                      : brand.name === 'Carrier'
                      ? 'h-5 sm:h-6 max-w-[110px]'
                      : brand.name === 'LG'
                      ? 'h-5 sm:h-6 max-w-[70px]'
                      : brand.name === 'Arçelik'
                      ? 'h-5 sm:h-6 max-w-[105px]'
                      : 'h-4 sm:h-5 max-w-[95px]'
                  }`}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee-right {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-marquee-right {
    animation: marquee-right 30s linear infinite;
    will-change: transform;
  }
</style>

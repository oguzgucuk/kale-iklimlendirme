---
import company from '@/data_files/company.json';
import { FastQuoteModal } from '@/components/ui/FastQuoteModal';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section
  id="hero"
  class={`relative min-h-screen lg:h-screen w-full flex flex-col justify-between items-center overflow-hidden ${className}`}
>
  <!-- Tam Ekran Arka Plan Görseli (Kurumsal Plaza Çatı VRF Geniş Açı Gün Işığı & Mavi Gökyüzü) -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/hero-commercial-rooftop-vrf.jpg"
      alt="Kurumsal Plaza Çatı VRF Merkezi Sistem Tesisatı - Kale İklimlendirme"
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
      loading="eager"
    />
    
    <!-- Üst Gradyan: Şeffaf Header'ın (Logo, Navigasyon, Butonlar) gökyüzü üzerinde jilet gibi okunmasını sağlar -->
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-navy-950/85 via-navy-950/45 to-transparent pointer-events-none" aria-hidden="true"></div>

    <!-- Ortalanmış Mimari Atmosfer Gradyanı: Görseli kapatmadan ortadaki metinleri kristal netliğinde sunar -->
    <div class="absolute inset-0 bg-navy-950/45 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-navy-950/30 to-navy-950/80 pointer-events-none" aria-hidden="true"></div>
  </div>

  <!-- Orta Gövde: Tam Ortalanmış Tipografi, Butonlar ve Metrikler -->
  <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 pb-8 text-center flex flex-col items-center justify-center my-auto">
    
    <!-- H1 Başlık (Ortalanmış mimari tipografi) -->
    <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12] drop-shadow-md max-w-4xl mx-auto">
      Klima Satışından <span class="text-brand-400">VRF Merkezi Sistem</span> Projelendirmeye Uçtan Uca Çözüm.
    </h1>

    <!-- Açıklama Metni (Ortalanmış) -->
    <p class="text-base sm:text-lg lg:text-xl text-slate-100 leading-relaxed font-normal max-w-2xl mx-auto mt-5 sm:mt-6 drop-shadow-xs">
      Hastaneler, plazalar, kamu binaları ve nitelikli konut projelerinde doğru kapasite hesabı, 40 bar azot testli garantili borulama ve yetkili servis güvencesi.
    </p>

    <!-- Eylem Butonları (Ortalanmış) -->
    <div class="pt-7 sm:pt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 w-full">
      <FastQuoteModal client:load />

      <a
        href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-5 py-3 text-xs sm:text-sm font-bold text-white bg-[#25D366] hover:bg-[#20bd5a] rounded-lg shadow-md transition-all gap-2"
      >
        <svg class="h-4.5 w-4.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.599 2.674-.7c.976.58 2.019.882 3.209.882h.001c3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.768zm3.366 8.163c-.141.397-.714.729-1.026.776-.29.043-.654.072-2.12-.533-1.875-.776-3.08-2.697-3.174-2.82-.093-.124-.764-1.018-.764-1.942 0-.923.483-1.378.654-1.564.171-.186.374-.233.499-.233.124 0 .249.002.358.007.115.006.269-.044.421.323.157.38.537 1.309.584 1.405.047.096.078.209.016.333-.063.125-.094.202-.187.311-.093.11-.197.246-.281.33-.094.094-.192.197-.082.386.11.189.489.808 1.05 1.307.722.643 1.33.842 1.519.935.188.094.3.078.411-.047.112-.125.48-559.608-.751.127-.192.256-.16.429-.096.173.064 1.096.517 1.284.611.188.094.313.141.359.219.047.078.047.452-.094.849zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.176L2 22l4.982-1.397A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>WhatsApp Keşif Hattı</span>
      </a>

      <a
        href={`tel:${company.phoneRaw}`}
        class="inline-flex items-center justify-center px-5 py-3 text-xs sm:text-sm font-bold text-white bg-navy-900/60 hover:bg-navy-900/80 rounded-lg border border-white/20 transition-all gap-2 backdrop-blur-md shadow-xs"
      >
        <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{company.phone}</span>
      </a>
    </div>

    <!-- Mimari Metrik Çubuğu (Ortalanmış, hairline zemin çizgili) -->
    <div class="pt-8 mt-8 border-t border-white/20 w-full max-w-xl mx-auto">
      <div class="grid grid-cols-3 gap-2 divide-x divide-white/20 text-center">
        <div class="px-2">
          <div class="font-heading text-2xl sm:text-3xl font-extrabold text-brand-400 tracking-tight drop-shadow-xs">15+ Yıl</div>
          <div class="text-[11px] sm:text-xs text-slate-200 font-medium mt-0.5">Sektörel Deneyim</div>
        </div>
        <div class="px-2">
          <div class="font-heading text-2xl sm:text-3xl font-extrabold text-white tracking-tight drop-shadow-xs">450+</div>
          <div class="text-[11px] sm:text-xs text-slate-200 font-medium mt-0.5">Tamamlanan Proje</div>
        </div>
        <div class="px-2">
          <div class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-100 tracking-tight drop-shadow-xs">8 Marka</div>
          <div class="text-[11px] sm:text-xs text-slate-200 font-medium mt-0.5">Yetkili Çözüm Ortaklığı</div>
        </div>
      </div>
    </div>

  </div>

  <!-- Aşağı Kaydır Göstergesi (Hero görselinin tamamı ekranda, marka kısmı bi tık aşağıda) -->
  <div class="relative z-10 pb-6 text-center">
    <a
      href="#markalar"
      class="inline-flex flex-col items-center gap-1.5 text-white/75 hover:text-white transition-colors cursor-pointer group"
      aria-label="Aşağı kaydır"
    >
      <span class="text-[10px] sm:text-[11px] tracking-widest uppercase font-semibold text-slate-200 group-hover:text-brand-400 transition-colors">Yetkili Markalar & Hizmetler</span>
      <svg class="w-4 h-4 animate-bounce text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>

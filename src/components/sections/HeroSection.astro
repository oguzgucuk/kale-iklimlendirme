---
import company from '@/data_files/company.json';
import { FastQuoteModal } from '@/components/ui/FastQuoteModal';
import { Badge } from '@/components/ui/badge';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section
  id="hero"
  class={`relative min-h-screen min-h-[100dvh] flex flex-col justify-between bg-navy-950 text-white overflow-hidden pt-28 sm:pt-36 pb-8 sm:pb-12 ${className}`}
>
  <!-- 1. Background Cinematic Image with Optimized Responsive Loading -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/hero-vrf.webp"
      alt="Kale İklimlendirme VRF Merkezi Sistem Kurulumu ve Mühendislik Altyapısı"
      class="w-full h-full object-cover object-center scale-105 animate-fade-in"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Multi-layered High-Contrast Gradient Overlays for Maximum Legibility -->
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-950/80 to-navy-900/50" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-transparent to-navy-950/70" aria-hidden="true"></div>
  </div>

  <!-- 2. Main Hero Content Container (Centered Vertically) -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-auto w-full">
    <div class="max-w-3xl space-y-5 sm:space-y-6">
      
      <!-- Trust Badge -->
      <div>
        <Badge variant="brand" className="py-1.5 px-3.5 text-xs font-semibold gap-2 border-brand-400/40 bg-navy-950/80 backdrop-blur-sm text-brand-300 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse" aria-hidden="true"></span>
          Profesyonel VRF & Kurumsal İklimlendirme Mühendisliği
        </Badge>
      </div>

      <!-- Semantic Primary Heading H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
        Klima Satışından <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 via-brand-400 to-cyan-200">VRF Merkezi Sistem</span> Projelendirmeye Uçtan Uca Çözüm.
      </h1>

      <p class="text-base sm:text-lg lg:text-xl text-gray-200 leading-relaxed max-w-2xl font-normal drop-shadow-sm">
        Ev, ofis ve büyük ölçekli ticari binalar için doğru kapasite hesabı, garantili montaj, 
        7/24 kesintisiz arıza servisi ve periyodik hijyenik bakım hizmetleri.
      </p>

      <!-- CTA Action Area -->
      <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-3.5">
        <FastQuoteModal client:load />

        <a
          href={`tel:${company.phoneRaw}`}
          class="inline-flex items-center justify-center px-6 py-3.5 text-sm sm:text-base font-bold text-white bg-navy-900/90 hover:bg-navy-900 rounded-xl border border-gray-600/80 hover:border-brand-400/80 backdrop-blur-sm transition-all gap-2.5 shadow-lg shadow-black/20 group"
        >
          <svg class="w-5 h-5 text-alert group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Hemen Arayın: <strong>{company.phone}</strong></span>
        </a>
      </div>

      <!-- Metric Highlights List -->
      <ul class="pt-6 sm:pt-8 grid grid-cols-2 sm:grid-cols-3 gap-5 border-t border-white/15 list-none p-0 m-0">
        <li>
          <div class="text-2xl sm:text-3xl font-extrabold text-brand-400">15+ Yıl</div>
          <div class="text-xs sm:text-sm text-gray-300 font-medium mt-0.5">Sektörel Deneyim</div>
        </li>
        <li>
          <div class="text-2xl sm:text-3xl font-extrabold text-white">450+</div>
          <div class="text-xs sm:text-sm text-gray-300 font-medium mt-0.5">VRF & Ticari Proje</div>
        </li>
        <li class="col-span-2 sm:col-span-1">
          <div class="text-2xl sm:text-3xl font-extrabold text-alert">7/24</div>
          <div class="text-xs sm:text-sm text-gray-300 font-medium mt-0.5">Nöbetçi Acil Destek</div>
        </li>
      </ul>

    </div>
  </div>
</section>

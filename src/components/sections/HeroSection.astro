---
import company from '@/data_files/company.json';
import { FastQuoteModal } from '@/components/ui/FastQuoteModal';
import { Badge } from '@/components/ui/badge';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section class={`relative bg-navy-900 text-white overflow-hidden py-14 sm:py-20 lg:py-28 border-b border-navy-950 ${className}`}>
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0EA5B7_1px,transparent_1px)] [background-size:24px_24px]" aria-hidden="true"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-5 sm:space-y-6">
      
      <!-- Trust badge -->
      <div>
        <Badge variant="brand" className="py-1.5 px-3.5 text-xs font-semibold gap-2 border-brand-500/40 bg-navy-950 text-brand-300">
          <span class="w-2 h-2 rounded-full bg-brand-400" aria-hidden="true"></span>
          Yetkili VRF ve Kurumsal İklimlendirme Mühendisliği
        </Badge>
      </div>

      <!-- Semantic Primary Heading H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
        Klima Satışından <span class="text-brand-400">VRF Merkezi Sistem</span> Projelendirmeye Uçtan Uca Çözüm.
      </h1>

      <p class="text-base sm:text-lg lg:text-xl text-gray-300 leading-relaxed max-w-2xl font-normal">
        Ev, ofis ve büyük ölçekli ticari binalar için doğru kapasite hesabı, profesyonel montaj, 
        7/24 kesintisiz arıza servisi ve periyodik hijyenik bakım hizmetleri.
      </p>

      <!-- CTA Action Area (Mobile-First: stack vertically on mobile, horizontal on sm+) -->
      <div class="pt-2 flex flex-col sm:flex-row sm:items-center gap-3.5">
        <FastQuoteModal client:load />

        <a
          href={`tel:${company.phoneRaw}`}
          class="inline-flex items-center justify-center px-6 py-3 text-sm sm:text-base font-bold text-white bg-navy-950 hover:bg-navy-950/80 rounded-xl border border-gray-700 transition-all gap-2.5 shadow-sm"
        >
          <svg class="w-5 h-5 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Hemen Arayın: <strong>{company.phone}</strong></span>
        </a>
      </div>

      <!-- Semantic Metric List: ul / li -->
      <ul class="pt-6 sm:pt-8 grid grid-cols-2 sm:grid-cols-3 gap-5 border-t border-gray-800/80 list-none p-0 m-0">
        <li>
          <div class="text-2xl sm:text-3xl font-extrabold text-brand-400">15+ Yıl</div>
          <div class="text-xs sm:text-sm text-gray-400 font-medium mt-0.5">Sektörel Deneyim</div>
        </li>
        <li>
          <div class="text-2xl sm:text-3xl font-extrabold text-white">450+</div>
          <div class="text-xs sm:text-sm text-gray-400 font-medium mt-0.5">VRF & Ticari Proje</div>
        </li>
        <li class="col-span-2 sm:col-span-1">
          <div class="text-2xl sm:text-3xl font-extrabold text-alert">7/24</div>
          <div class="text-xs sm:text-sm text-gray-400 font-medium mt-0.5">Acil Teknik Destek</div>
        </li>
      </ul>

    </div>
  </div>
</section>

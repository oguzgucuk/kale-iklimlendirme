---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const brands = [
  {
    name: 'Carrier',
    logo: '/images/brand/carrier.webp',
    alt: 'Carrier VRF ve Bireysel Klima Sistemleri',
  },
  {
    name: 'GREE',
    logo: '/images/brand/gree.svg',
    alt: 'Gree Klima ve İklimlendirme Sistemleri',
  },
  {
    name: 'LG',
    logo: '/images/brand/lg.png',
    alt: 'LG Multi V ve Inverter İklimlendirme Sistemleri',
  },
  {
    name: 'Midea',
    logo: '/images/brand/midea.webp',
    alt: 'Midea Ticari ve Bireysel Klimalar',
  },
  {
    name: 'Samsung',
    logo: '/images/brand/samsung.svg',
    alt: 'Samsung Klima Sistemleri',
  },
  {
    name: 'Daikin',
    logo: '/images/brand/daikin.webp',
    alt: 'Daikin VRV ve Inverter Klima Çözümleri',
  },
  {
    name: 'Arçelik',
    logo: '/images/brand/arcelik.webp',
    alt: 'Arçelik Kurumsal ve Bireysel İklimlendirme',
  },
  {
    name: 'Mitsubishi Electric',
    logo: '/images/brand/mitsubishi.png',
    alt: 'Mitsubishi Electric Klima Sistemleri',
  },
];
---

<section id="markalar" class={`py-3.5 sm:py-4 bg-white border-b border-gray-200/80 overflow-hidden ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Başlık Bloğu -->
    <div class="mb-1.5 text-center">
      <span class="text-[10px] sm:text-[11px] font-extrabold text-slate-400 uppercase tracking-widest block">
        Yetkili Çözüm Ortakları
      </span>
    </div>

    <!-- Kayan Logo Şeridi: Sitenin genel genişlik sınırları (max-w-7xl) içinde tutulur -->
    <div class="relative w-full overflow-hidden select-none pointer-events-none">
      <!-- Sol ve Sağ Yumuşak Geçiş (Fade) Gradyanları -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-28 bg-gradient-to-r from-white via-white/90 to-transparent z-10" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-28 bg-gradient-to-l from-white via-white/90 to-transparent z-10" aria-hidden="true"></div>

      <!-- Kayan Hat (Track) -->
      <div class="flex w-max items-center py-1">
        <!-- 1. Grup (Sadece orijinal markalar - ekranda aynı markanın mükerrer görünmesini engeller) -->
        <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0 animate-marquee-right">
          {brands.map((brand) => (
            <div class="flex items-center justify-center shrink-0">
              <img
                src={brand.logo}
                alt={brand.alt}
                class={`w-auto object-contain pointer-events-none select-none ${
                  brand.name === 'Mitsubishi Electric'
                    ? 'h-6 sm:h-7 max-w-[125px]'
                    : brand.name === 'Carrier'
                    ? 'h-5 sm:h-6 max-w-[110px]'
                    : brand.name === 'LG'
                    ? 'h-5 sm:h-6 max-w-[75px]'
                    : brand.name === 'Arçelik'
                    ? 'h-5 sm:h-6 max-w-[105px]'
                    : 'h-4 sm:h-5 max-w-[95px]'
                }`}
                loading="lazy"
              />
            </div>
          ))}
        </div>

        <!-- 2. Grup (Kusursuz Kesintisiz Döngü İçin Kopya) -->
        <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0 animate-marquee-right" aria-hidden="true">
          {brands.map((brand) => (
            <div class="flex items-center justify-center shrink-0">
              <img
                src={brand.logo}
                alt={brand.alt}
                class={`w-auto object-contain pointer-events-none select-none ${
                  brand.name === 'Mitsubishi Electric'
                    ? 'h-6 sm:h-7 max-w-[125px]'
                    : brand.name === 'Carrier'
                    ? 'h-5 sm:h-6 max-w-[110px]'
                    : brand.name === 'LG'
                    ? 'h-5 sm:h-6 max-w-[75px]'
                    : brand.name === 'Arçelik'
                    ? 'h-5 sm:h-6 max-w-[105px]'
                    : 'h-4 sm:h-5 max-w-[95px]'
                }`}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee-right {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-marquee-right {
    animation: marquee-right 30s linear infinite;
    will-change: transform;
  }
</style>

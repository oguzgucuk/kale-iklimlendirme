---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const brands = [
  {
    name: 'Carrier',
    logo: '/images/brand/carrier.webp',
    alt: 'Carrier VRF ve Bireysel Klima Sistemleri',
  },
  {
    name: 'GREE',
    logo: '/images/brand/gree.svg',
    alt: 'Gree Klima ve İklimlendirme Sistemleri',
  },
  {
    name: 'Midea',
    logo: '/images/brand/midea.webp',
    alt: 'Midea Ticari ve Bireysel Klimalar',
  },
  {
    name: 'Samsung',
    logo: '/images/brand/samsung.svg',
    alt: 'Samsung Klima Sistemleri',
  },
  {
    name: 'Daikin',
    logo: '/images/brand/daikin.webp',
    alt: 'Daikin VRV ve Inverter Klima Çözümleri',
  },
  {
    name: 'Arçelik',
    logo: '/images/brand/arcelik.webp',
    alt: 'Arçelik Kurumsal ve Bireysel İklimlendirme',
  },
  {
    name: 'Mitsubishi Electric',
    logo: '/images/brand/mitsubishi.png',
    alt: 'Mitsubishi Electric Klima Sistemleri',
  },
];
---

<section id="markalar" class={`py-12 bg-white border-b border-gray-200/80 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Başlık Bloğu: Açıklama metni başlığın tam altına alındı, 'Markalar' artık tek başına düşmez -->
    <div class="mb-8 space-y-1.5">
      <span class="text-xs font-bold text-brand-600 tracking-wider uppercase block">
        Lider Markalarla Kesintisiz Uyum
      </span>
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-navy-900 leading-tight">
        Satış, Montaj ve Periyodik Bakımını Gerçekleştirdiğimiz Markalar
      </h2>
      <p class="text-xs sm:text-sm text-gray-500 font-normal max-w-3xl leading-relaxed pt-1">
        Tüm montaj ve tesisat işlerimizde orijinal standartlarda malzeme ve üretici standartlarında garantili parçalar kullanılır.
      </p>
    </div>

    <!-- Marka Logoları Grid (Carrier eklendi, 7 marka responsive dizilim) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3.5 sm:gap-4">
      {brands.map((brand) => (
        <div class="group flex items-center justify-center p-3 sm:p-4 bg-surface hover:bg-white rounded-2xl border border-gray-200/90 hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10 transition-all duration-200 h-24">
          <img
            src={brand.logo}
            alt={brand.alt}
            class={`w-auto object-contain transition-transform duration-200 group-hover:scale-105 ${
              brand.name === 'Mitsubishi Electric'
                ? 'max-h-11 max-w-[135px]'
                : brand.name === 'Carrier'
                ? 'max-h-10 max-w-[115px]'
                : 'max-h-9 max-w-[115px]'
            }`}
            loading="lazy"
          />
        </div>
      ))}
    </div>

  </div>
</section>

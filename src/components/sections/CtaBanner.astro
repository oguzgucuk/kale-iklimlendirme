---
import company from '@/data_files/company.json';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<aside class={`bg-navy-900 text-white py-14 sm:py-16 border-t border-navy-950 ${className}`} aria-label="Hemen İletişime Geçin">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
    
    <span class="inline-flex items-center gap-2 rounded-full bg-navy-950 px-3 py-1 text-xs font-semibold text-brand-300 border border-brand-500/30">
      <span class="h-2 w-2 rounded-full bg-brand-400"></span>
      Ücretsiz Mühendislik Keşfi
    </span>

    <h2 class="text-2xl sm:text-4xl font-extrabold text-white max-w-3xl mx-auto leading-tight">
      Projeniz İçin Doğru İklimlendirme Kapasitesini Belirleyelim
    </h2>

    <p class="text-sm sm:text-base text-gray-300 max-w-2xl mx-auto leading-relaxed">
      Mühendislerimiz mekanınızı yerinde incelesin, en verimli klima ve VRF merkezi sistem teklifini 24 saat içinde ücretsiz sunsun.
    </p>

    <!-- Call to Action Buttons (Mobile-First: stack on mobile, flex-row on sm) -->
    <div class="pt-3 flex flex-col sm:flex-row justify-center items-center gap-3.5">
      <a
        href="/iletisim"
        class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 text-sm sm:text-base font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-xl shadow-md transition-all hover:-translate-y-0.5"
      >
        Hemen Keşif Talep Edin
      </a>

      <a
        href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 text-sm sm:text-base font-bold text-white bg-[#25D366] hover:bg-[#20bd5a] rounded-xl shadow-md transition-all gap-2 hover:-translate-y-0.5"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.599 2.674-.7c.976.58 2.019.882 3.209.882h.001c3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.767-5.768zm3.366 8.163c-.141.397-.714.729-1.026.776-.29.043-.654.072-2.12-.533-1.875-.776-3.08-2.697-3.174-2.82-.093-.124-.764-1.018-.764-1.942 0-.923.483-1.378.654-1.564.171-.186.374-.233.499-.233.124 0 .249.002.358.007.115.006.269-.044.421.323.157.38.537 1.309.584 1.405.047.096.078.209.016.333-.063.125-.094.202-.187.311-.093.11-.197.246-.281.33-.094.094-.192.197-.082.386.11.189.489.808 1.05 1.307.722.643 1.33.842 1.519.935.188.094.3.078.411-.047.112-.125.48-559.608-.751.127-.192.256-.16.429-.096.173.064 1.096.517 1.284.611.188.094.313.141.359.219.047.078.047.452-.094.849zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.176L2 22l4.982-1.397A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>WhatsApp ile Hızlı İletişim</span>
      </a>
    </div>

  </div>
</aside>

---
import company from '@/data_files/company.json';
import { navBarLinks } from '@/utils/navigation';

const currentPath = Astro.url.pathname;
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-gray-200/80 shadow-xs transition-all duration-200"
>
  <!-- Main Navigation Bar (64px) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="nav-container" class="flex justify-between items-center h-16">
      
      <!-- Brand Logo & Title -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none">
        <div class="w-9 h-9 rounded-lg bg-navy-950 flex items-center justify-center text-brand-400 group-hover:bg-brand-500 group-hover:text-white transition-all shadow-sm">
          <!-- Industrial HVAC Ventilation Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
            <circle cx="12" cy="12" r="3" stroke-width="2" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-extrabold tracking-tight text-navy-950 leading-tight">
            KALE <span class="text-brand-600">İKLİMLENDİRME</span>
          </span>
          <span class="text-[10px] font-bold text-gray-500 tracking-wider uppercase">
            VRF Sistemleri & Klima Mühendisliği
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-6">
        {navBarLinks.map((link) => {
          const isActive = currentPath === link.url || (link.url !== '/' && currentPath.startsWith(link.url));
          const hasSublinks = link.sublinks && link.sublinks.length > 0;

          if (hasSublinks) {
            return (
              <div class="relative group py-4">
                <a
                  href={link.url}
                  class={`inline-flex items-center gap-1 text-sm font-semibold transition-colors ${
                    isActive ? 'text-brand-600 font-bold' : 'text-gray-700 hover:text-brand-600'
                  }`}
                >
                  {link.name}
                  <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-brand-600 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Dropdown Menu -->
                <div class="absolute left-0 top-full -mt-1 w-72 bg-white rounded-xl shadow-2xl border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-2 z-50">
                  <div class="space-y-0.5">
                    {link.sublinks?.map((sub) => (
                      <a
                        href={sub.url}
                        class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors"
                      >
                        <div class="font-bold text-xs sm:text-sm text-navy-950 hover:text-brand-600">{sub.name}</div>
                        {sub.description && (
                          <div class="text-[11px] text-gray-500 mt-0.5 line-clamp-1">{sub.description}</div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.url}
              class={`text-sm font-semibold transition-colors ${
                isActive ? 'text-brand-600 font-bold' : 'text-gray-700 hover:text-brand-600'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-2.5">
        <a
          href={`tel:${company.phoneRaw}`}
          class="flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-navy-950 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200 transition-all"
          title="Doğrudan Arayın"
        >
          <svg class="w-3.5 h-3.5 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden xl:inline">{company.phone}</span>
          <span class="xl:hidden">Hemen Ara</span>
        </a>

        <!-- "Keşif Al" Butonu -->
        <a
          href="/iletisim/"
          class="inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-lg shadow-sm transition-all"
        >
          Keşif Al
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={`tel:${company.phoneRaw}`}
          class="p-2 text-navy-950 bg-slate-100 rounded-lg border border-slate-200"
          aria-label="Ara"
        >
          <svg class="w-4 h-4 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 text-navy-950 hover:bg-slate-100 rounded-lg focus:outline-none"
          aria-label="Menüyü Aç"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white px-4 pt-3 pb-6 space-y-2 shadow-2xl">
    {navBarLinks.map((link) => (
      <div>
        <a
          href={link.url}
          class="block py-2 text-base font-semibold text-navy-950 hover:text-brand-600 border-b border-gray-100"
        >
          {link.name}
        </a>
        {link.sublinks && (
          <div class="pl-4 py-1 space-y-1 bg-slate-50 rounded-lg mt-1">
            {link.sublinks.map((sub) => (
              <a
                href={sub.url}
                class="block py-1.5 text-sm text-gray-600 hover:text-brand-600 font-medium"
              >
                {sub.name}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <div class="pt-4 flex flex-col gap-2.5">
      <a
        href={`tel:${company.phoneRaw}`}
        class="w-full flex items-center justify-center gap-2 py-2.5 text-sm font-bold text-navy-950 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200"
      >
        <svg class="w-4 h-4 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Hemen Arayın: {company.phone}
      </a>

      <a
        href="/iletisim/"
        class="w-full text-center py-2.5 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-lg shadow-sm"
      >
        Keşif Al
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>

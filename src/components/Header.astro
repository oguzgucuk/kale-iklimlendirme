---
import company from '@/data_files/company.json';
import { navBarLinks } from '@/utils/navigation';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
---

<header
  id="main-header"
  class={`z-50 transition-all duration-300 border-none outline-none ${
    isHome
      ? 'fixed top-0 left-0 right-0 bg-transparent'
      : 'sticky top-0 w-full bg-[#101828] shadow-xl shadow-black/20'
  }`}
>
  <!-- Main Navigation Bar (Kompakt 64px yükseklik) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="nav-container" class="flex justify-between items-center h-16 transition-all duration-300">
      
      <!-- Brand Logo & Title -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none">
        <div class="w-9 h-9 rounded-lg bg-navy-900/80 border border-white/20 flex items-center justify-center text-brand-400 group-hover:bg-brand-500 group-hover:text-white transition-all shadow-sm">
          <!-- Industrial HVAC Ventilation Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
            <circle cx="12" cy="12" r="3" stroke-width="2" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold tracking-tight text-white leading-tight">
            KALE <span class="text-brand-400 font-extrabold">İKLİMLENDİRME</span>
          </span>
          <span class="text-[10px] font-semibold text-gray-300 tracking-wider uppercase">
            VRF Sistemleri & Klima Mühendisliği
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-6">
        {navBarLinks.map((link) => {
          const isActive = currentPath === link.url || (link.url !== '/' && currentPath.startsWith(link.url));
          const hasSublinks = link.sublinks && link.sublinks.length > 0;

          if (hasSublinks) {
            return (
              <div class="relative group py-4">
                <a
                  href={link.url}
                  class={`inline-flex items-center gap-1 text-sm font-semibold transition-colors ${
                    isActive ? 'text-brand-400' : 'text-white/90 hover:text-brand-400'
                  }`}
                >
                  {link.name}
                  <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-brand-400 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Dropdown Menu -->
                <div class="absolute left-0 top-full -mt-1 w-72 bg-[#101828] backdrop-blur-md rounded-xl shadow-2xl border border-navy-800 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-2.5 z-50">
                  <div class="space-y-0.5">
                    {link.sublinks?.map((sub) => (
                      <a
                        href={sub.url}
                        class="block px-3 py-2 rounded-lg hover:bg-navy-900 transition-colors"
                      >
                        <div class="font-medium text-xs sm:text-sm text-white hover:text-brand-400">{sub.name}</div>
                        {sub.description && (
                          <div class="text-[11px] text-gray-400 mt-0.5 line-clamp-1">{sub.description}</div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.url}
              class={`text-sm font-semibold transition-colors ${
                isActive ? 'text-brand-400' : 'text-white/90 hover:text-brand-400'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-2.5">
        <a
          href={`tel:${company.phoneRaw}`}
          class="flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-white bg-white/10 hover:bg-white/20 rounded-lg border border-white/20 backdrop-blur-sm transition-all"
          title="Doğrudan Arayın"
        >
          <svg class="w-3.5 h-3.5 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden xl:inline">{company.phone}</span>
          <span class="xl:hidden">Hemen Ara</span>
        </a>

        <!-- "Keşif Al" Butonu -->
        <a
          href="/iletisim"
          class="inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-lg shadow-md shadow-brand-500/20 transition-all focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
        >
          Keşif Al
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={`tel:${company.phoneRaw}`}
          class="p-2 text-white bg-white/10 rounded-lg border border-white/20"
          aria-label="Ara"
        >
          <svg class="w-4 h-4 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 text-white hover:bg-white/10 rounded-lg focus:outline-none"
          aria-label="Menüyü Aç"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-navy-800 bg-[#101828]/98 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2 shadow-2xl">
    {navBarLinks.map((link) => (
      <div>
        <a
          href={link.url}
          class="block py-2 text-base font-semibold text-white hover:text-brand-400 border-b border-navy-900"
        >
          {link.name}
        </a>
        {link.sublinks && (
          <div class="pl-4 py-1 space-y-1 bg-navy-900/60 rounded-lg mt-1">
            {link.sublinks.map((sub) => (
              <a
                href={sub.url}
                class="block py-1.5 text-sm text-gray-300 hover:text-brand-400 font-medium"
              >
                {sub.name}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <div class="pt-4 flex flex-col gap-2.5">
      <a
        href={`tel:${company.phoneRaw}`}
        class="w-full flex items-center justify-center gap-2 py-2.5 text-sm font-bold text-white bg-white/10 hover:bg-white/20 rounded-lg border border-white/20"
      >
        <svg class="w-4 h-4 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Hemen Arayın: {company.phone}
      </a>

      <a
        href="/iletisim"
        class="w-full text-center py-2.5 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-lg shadow-md shadow-brand-500/20"
      >
        Keşif Al
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const isHomePage = window.location.pathname === '/';

  function onGlobalScroll() {
    const isScrolled = window.scrollY > 15;

    // Ana Sayfa: İlk açılışta şeffaf, tek scrollda #101828 laciverte dönüşür
    if (isHomePage && header) {
      if (isScrolled) {
        header.classList.add('bg-[#101828]', 'shadow-2xl', 'shadow-black/30');
        header.classList.remove('bg-transparent');
      } else {
        header.classList.remove('bg-[#101828]', 'shadow-2xl', 'shadow-black/30');
        header.classList.add('bg-transparent');
      }
    }
  }

  window.addEventListener('scroll', onGlobalScroll, { passive: true });
  onGlobalScroll();

  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>

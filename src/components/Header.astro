---
/* Hallmark · component: Header · genre: modern-minimal · system: design.md · nav: N1b · height: 64px */
import company from '@/data_files/company.json';
import { navBarLinks } from '@/utils/navigation';

interface Props {
  isTransparent?: boolean;
}

const { isTransparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  id="main-header"
  class={`z-50 w-full transition-all duration-300 ease-out ${
    isTransparent
      ? 'fixed top-0 inset-x-0 bg-transparent text-white border-b border-white/10'
      : 'sticky top-0 bg-navy-950/95 backdrop-blur-md text-white border-b border-white/10 shadow-sm'
  }`}
  data-transparent={isTransparent ? 'true' : 'false'}
>
  <!-- Full-Width Navigation Bar: 64px (h-16) Hallmark Mimari Yükseklik -->
  <div class="w-full px-4 sm:px-8 lg:px-12">
    <div id="nav-container" class="flex justify-between items-center h-16">
      
      <!-- Brand Logo & Title (En Sol Üst - Hallmark Architectural Logo) -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none shrink-0" aria-label="Kale İklimlendirme Ana Sayfa">
        <div class="w-8 h-8 rounded-md flex items-center justify-center transition-all shadow-xs bg-navy-900 border border-white/20 text-brand-400 group-hover:bg-brand-500 group-hover:text-white">
          <!-- Industrial HVAC Ventilation Rotor Icon -->
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
            <circle cx="12" cy="12" r="3" stroke-width="2" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-[15px] sm:text-base font-extrabold tracking-tight leading-tight font-heading text-white">
            KALE <span class="text-brand-400">İKLİMLENDİRME</span>
          </span>
          <span class="text-[9.5px] font-sans font-semibold tracking-wider uppercase text-slate-300">
            VRF Sistemleri & Mühendislik
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links (Ortalanmış ve Rafine Tipografi) -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Ana Menü">
        {navBarLinks.map((link) => {
          const isActive = currentPath === link.url || (link.url !== '/' && currentPath.startsWith(link.url));
          const hasSublinks = link.sublinks && link.sublinks.length > 0;

          if (hasSublinks) {
            return (
              <div class="relative group py-3">
                <a
                  href={link.url}
                  class={`inline-flex items-center gap-1 text-[13px] font-semibold tracking-wide transition-colors ${
                    isActive
                      ? 'text-brand-400 font-bold'
                      : 'text-slate-200 hover:text-white'
                  }`}
                >
                  {link.name}
                  <svg class="w-3 h-3 opacity-70 group-hover:opacity-100 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <!-- Dropdown Menu -->
                <div class="absolute left-0 top-full -mt-0.5 w-72 bg-navy-950/95 text-white backdrop-blur-xl rounded-lg shadow-2xl border border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-1.5 z-50">
                  <div class="space-y-0.5">
                    {link.sublinks?.map((sub) => (
                      <a
                        href={sub.url}
                        class="block px-3 py-2 rounded-md hover:bg-white/10 transition-colors"
                      >
                        <div class="font-bold text-xs text-white hover:text-brand-400">{sub.name}</div>
                        {sub.description && (
                          <div class="text-[10.5px] text-slate-300 mt-0.5 line-clamp-1">{sub.description}</div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.url}
              class={`text-[13px] font-semibold tracking-wide transition-colors ${
                isActive
                  ? 'text-brand-400 font-bold'
                  : 'text-slate-200 hover:text-white'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Buttons (En Sağ Taraf - Hallmark Modern Minimal CTA) -->
      <div class="hidden sm:flex items-center gap-2.5 shrink-0">
        <a
          href={`tel:${company.phoneRaw}`}
          class="flex items-center gap-2 px-3.5 py-1.5 text-xs sm:text-[13px] font-bold rounded-md border transition-all bg-white/10 hover:bg-white/20 border-white/20 text-white backdrop-blur-xs whitespace-nowrap"
          title="Doğrudan Arayın"
        >
          <svg class="w-3.5 h-3.5 text-alert shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden xl:inline font-sans font-bold tracking-normal">{company.phone}</span>
          <span class="xl:hidden font-sans font-bold">Hemen Ara</span>
        </a>

        <!-- "Keşif Al" Butonu -->
        <a
          href="/iletisim/"
          class="inline-flex items-center justify-center px-4 py-1.5 text-xs sm:text-[13px] font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-md shadow-xs transition-all whitespace-nowrap"
        >
          Keşif Al
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={`tel:${company.phoneRaw}`}
          class="p-1.5 rounded-md border text-white bg-white/10 border-white/20"
          aria-label="Telefonla Arayın"
        >
          <svg class="w-4 h-4 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-1.5 rounded-md focus:outline-none text-white hover:bg-white/10"
          aria-label="Menüyü Aç"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-navy-950/98 text-white px-4 pt-3 pb-6 space-y-2 shadow-2xl backdrop-blur-md">
    {navBarLinks.map((link) => (
      <div>
        <a
          href={link.url}
          class="block py-2 text-sm font-semibold text-white hover:text-brand-400 border-b border-white/10"
        >
          {link.name}
        </a>
        {link.sublinks && (
          <div class="pl-4 py-1 space-y-1 bg-white/5 rounded-md mt-1">
            {link.sublinks.map((sub) => (
              <a
                href={sub.url}
                class="block py-1.5 text-xs text-slate-300 hover:text-brand-400 font-medium"
              >
                {sub.name}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}

    <div class="pt-4 flex flex-col gap-2.5">
      <a
        href={`tel:${company.phoneRaw}`}
        class="w-full flex items-center justify-center gap-2 py-2.5 text-xs font-bold text-white bg-white/10 hover:bg-white/20 rounded-md border border-white/20 font-sans"
      >
        <svg class="w-3.5 h-3.5 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Hemen Arayın: {company.phone}
      </a>

      <a
        href="/iletisim/"
        class="w-full text-center py-2 text-xs font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-md shadow-xs"
      >
        Keşif Al
      </a>
    </div>
  </div>
</header>

<script>
  // Hallmark Discipline: rAF Throttled, Passive Scroll Listener with Boolean-Flip Guard
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const header = document.getElementById('main-header');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  // Scroll Morph Handler (threshold >= 60px to prevent jitter, rAF throttled)
  if (header && header.dataset.transparent === 'true') {
    const THRESHOLD = 60;
    let isScrolled = false;
    let ticking = false;

    const updateHeader = () => {
      const nextScrolled = window.scrollY > THRESHOLD;
      if (nextScrolled !== isScrolled) {
        isScrolled = nextScrolled;
        if (isScrolled) {
          header.classList.add('bg-navy-950/90', 'backdrop-blur-md', 'shadow-md', 'border-white/10');
          header.classList.remove('bg-transparent', 'border-transparent');
        } else {
          header.classList.remove('bg-navy-950/90', 'backdrop-blur-md', 'shadow-md', 'border-white/10');
          header.classList.add('bg-transparent', 'border-transparent');
        }
      }
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(() => {
          updateHeader();
          ticking = false;
        });
      }
    }, { passive: true });

    updateHeader();
  }
</script>

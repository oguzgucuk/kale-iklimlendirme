---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { Badge } from '@/components/ui/badge';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const formattedDate = new Date(project.data.completedDate).toLocaleDateString('tr-TR', {
  year: 'numeric',
  month: 'long',
});
---

<MainLayout
  title={`${project.data.title} | ${company.companyName}`}
  description={project.data.summary}
>
  <!-- Semantic Page Header -->
  <header class="bg-navy-900 text-white py-12 sm:py-16 border-b border-navy-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Semantic Breadcrumb -->
      <nav aria-label="Erişim Yolu" class="mb-4">
        <ol class="flex items-center gap-2 text-xs text-gray-400 list-none p-0 m-0">
          <li>
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li>
            <a href="/projeler" class="hover:text-white transition-colors">Projelerimiz</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li class="text-brand-400 font-semibold" aria-current="page">{project.data.title}</li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-2.5 mb-2">
        <Badge variant="brand" className="font-semibold">
          {project.data.client}
        </Badge>
        <span class="text-xs text-gray-400">•</span>
        <span class="text-xs font-medium text-gray-300">{project.data.location}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mt-1.5 leading-tight">
        {project.data.title}
      </h1>
      <p class="text-sm sm:text-base text-gray-300 mt-3 leading-relaxed">
        {project.data.summary}
      </p>
    </div>
  </header>

  <!-- Project Details & Case Study Article -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    
    <!-- Specs Key Metrics Bar (Semantic list) -->
    <ul class="mb-10 grid grid-cols-1 sm:grid-cols-2 gap-4 rounded-2xl border border-gray-200 bg-surface p-5 sm:p-6 list-none m-0">
      <li>
        <span class="text-xs text-gray-500 font-medium block">Uygulanan İklimlendirme Sistemi:</span>
        <strong class="text-sm sm:text-base text-navy-900 font-bold mt-0.5 block">{project.data.systemType}</strong>
      </li>
      <li>
        <span class="text-xs text-gray-500 font-medium block">Teslim ve Devreye Alma Tarihi:</span>
        <strong class="text-sm sm:text-base text-navy-900 font-bold mt-0.5 block">{formattedDate}</strong>
      </li>
    </ul>

    <!-- Article Content -->
    <article class="bg-white rounded-2xl p-6 sm:p-10 border border-gray-200/90 shadow-sm">
      <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-navy-900 prose-h2:text-2xl prose-h2:border-b prose-h2:border-gray-100 prose-h2:pb-3 prose-h3:text-lg prose-p:text-gray-700 prose-p:leading-relaxed prose-li:text-gray-700">
        <Content />
      </div>

      <!-- Action Card -->
      <footer class="mt-10 pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a
          href="/projeler"
          class="text-sm font-bold text-navy-900 hover:text-brand-600 transition-colors inline-flex items-center gap-1.5"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Tüm Projelere Dön</span>
        </a>

        <a
          href="/iletisim"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl bg-brand-500 text-white font-bold text-sm hover:bg-brand-600 transition-colors shadow-sm text-center"
        >
          Benzer Bir Proje Başlatın
        </a>
      </footer>
    </article>

  </div>

  <!-- Global CTA Banner -->
  <CtaBanner />
</MainLayout>

---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<MainLayout
  title={`Projelerimiz & Referanslarımız | ${company.companyName}`}
  description="Tamamlanan VRF merkezi sistem uygulamaları, iş merkezleri, otel ve kurumsal bina iklimlendirme projelerimiz."
>
  <!-- Page Header -->
  <header class="bg-navy-900 text-white py-12 sm:py-16 border-b border-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Semantic Breadcrumb -->
      <nav aria-label="Erişim Yolu" class="mb-4">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-gray-400 list-none p-0 m-0">
          <li>
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li class="text-brand-400 font-semibold" aria-current="page">Projelerimiz</li>
        </ol>
      </nav>

      <span class="text-xs font-bold text-brand-400 uppercase tracking-widest block">
        Tamamlanan İşler
      </span>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-1.5 leading-tight font-heading break-words">
        Projelerimiz & Saha Referanslarımız
      </h1>
      <p class="text-sm sm:text-base text-gray-300 max-w-2xl mt-3 leading-relaxed">
        Otel, plaza, fabrika ve nitelikli konut projelerinde devreye aldığımız yüksek enerji verimli VRF merkezi sistem uygulamaları.
      </p>
    </div>
  </header>

  <!-- Projects Grid Section -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <header class="max-w-3xl mb-10 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 leading-tight">
          Kurumsal Referans Galerisi
        </h2>
        <p class="text-sm sm:text-base text-gray-600 mt-2">
          Mühendislik ekibimiz tarafından projelendirilen ve teslim edilen seçkin çalışmalarımız.
        </p>
      </header>

      <!-- Grid of Projects: Mobile 1 col, md 2 col, lg 3 col -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {projects
          .sort((a, b) => {
            if (a.id === 'tcdd-haydarpasa-vrf-bakim-onarim') return -1;
            if (b.id === 'tcdd-haydarpasa-vrf-bakim-onarim') return 1;
            return new Date(b.data.completedDate).getTime() - new Date(a.data.completedDate).getTime();
          })
          .map((project) => (
            <ProjectCard
              title={project.data.title}
              client={project.data.client}
              location={project.data.location}
              systemType={project.data.systemType}
              summary={project.data.summary}
              slug={project.id}
              coverImage={project.data.coverImage}
            />
        ))}
      </div>

    </div>
  </section>

  <!-- Sectoral Experience Highlights -->
  <section class="py-14 sm:py-16 bg-surface border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
        Sektörel Uzmanlık
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900">
        Farklı Sektörlerin İhtiyaçlarına Özel Projelendirme
      </h2>
      <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
        Turizm tesislerinin ultra sessiz oda konforu gereksiniminden, sanayi yapılarının yüksek hava debisi ve taze hava taleplerine kadar her sektöre özgü standartları eksiksiz uyguluyoruz.
      </p>
    </div>
  </section>

  <!-- CTA Banner -->
  <CtaBanner />
</MainLayout>

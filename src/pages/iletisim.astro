---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { ContactForm } from '@/components/ui/ContactForm';
import { getCollection } from 'astro:content';

const rawServices = await getCollection('services');
const serviceOptions = rawServices.map((s) => ({
  id: s.id,
  title: s.data.title,
}));
---

<MainLayout
  title={`İletişim & Ücretsiz Keşif Talebi | ${company.companyName}`}
  description="Kale İklimlendirme iletişim bilgileri, 7/24 acil servis hattı, WhatsApp danışma ve ücretsiz keşif formu."
>
  <!-- Page Header -->
  <header class="bg-navy-900 text-white py-12 sm:py-16 border-b border-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Semantic Breadcrumb -->
      <nav aria-label="Erişim Yolu" class="mb-4">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-gray-400 list-none p-0 m-0">
          <li>
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li class="text-brand-400 font-semibold" aria-current="page">İletişim</li>
        </ol>
      </nav>

      <span class="text-xs font-bold text-brand-400 uppercase tracking-widest block">
        Bize Ulaşın
      </span>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-1.5 leading-tight font-heading break-words">
        İletişim & Ücretsiz Keşif Başvurusu
      </h1>
      <p class="text-sm sm:text-base text-gray-300 max-w-2xl mt-3 leading-relaxed">
        VRF merkezi sistem projelendirme, klima satışı veya 7/24 acil arıza desteği için doğrudan arayabilir veya keşif formunu doldurabilirsiniz.
      </p>
    </div>
  </header>

  <!-- Main Contact Section (Mobile-First: Stack on mobile, 12-col grid on lg) -->
  <section class="py-14 sm:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
        
        <!-- Contact Directory Channels (5 cols on lg) -->
        <aside class="lg:col-span-5 space-y-6" aria-label="İletişim Kanalları">
          
          <div>
            <h2 class="text-2xl font-bold text-navy-900">Doğrudan İletişim Hatları</h2>
            <p class="text-sm text-gray-600 mt-1.5 leading-relaxed">
              Müşteri temsilcilerimiz mesai saatleri içinde anında, nöbetçi arıza ekibimiz ise 7/24 hizmetinizdedir.
            </p>
          </div>

          <div class="space-y-3.5">
            <!-- Main Santral Phone -->
            <a
              href={`tel:${company.phoneRaw}`}
              class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-200 hover:border-brand-500 transition-colors shadow-sm group"
            >
              <div class="w-11 h-11 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0 group-hover:bg-brand-500 group-hover:text-white transition-colors" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <span class="text-xs text-gray-500 font-medium block">Santral & Müşteri Hattı</span>
                <strong class="text-base sm:text-lg font-bold text-navy-900 group-hover:text-brand-600 transition-colors block mt-0.5">
                  {company.phone}
                </strong>
              </div>
            </a>

            <!-- WhatsApp Chat -->
            <a
              href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-4 p-4 rounded-2xl bg-[#25D366]/10 border border-[#25D366]/30 hover:bg-[#25D366]/20 transition-colors shadow-sm group"
            >
              <div class="w-11 h-11 rounded-xl bg-[#25D366] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.599 2.674-.7c.976.58 2.019.882 3.209.882h.001c3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.767-5.768zm3.366 8.163c-.141.397-.714.729-1.026.776-.29.043-.654.072-2.12-.533-1.875-.776-3.08-2.697-3.174-2.82-.093-.124-.764-1.018-.764-1.942 0-.923.483-1.378.654-1.564.171-.186.374-.233.499-.233.124 0 .249.002.358.007.115.006.269-.044.421.323.157.38.537 1.309.584 1.405.047.096.078.209.016.333-.063.125-.094.202-.187.311-.093.11-.197.246-.281.33-.094.094-.192.197-.082.386.11.189.489.808 1.05 1.307.722.643 1.33.842 1.519.935.188.094.3.078.411-.047.112-.125.48-559.608-.751.127-.192.256-.16.429-.096.173.064 1.096.517 1.284.611.188.094.313.141.359.219.047.078.047.452-.094.849zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.176L2 22l4.982-1.397A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
              </div>
              <div>
                <span class="text-xs text-emerald-800 font-bold block">WhatsApp Danışma Hattı</span>
                <strong class="text-base sm:text-lg font-bold text-navy-900 block mt-0.5">
                  {company.whatsappNumber}
                </strong>
              </div>
            </a>

            <!-- Emergency 7/24 Phone -->
            <a
              href={`tel:${company.emergencyPhoneRaw}`}
              class="flex items-start gap-4 p-4 rounded-2xl bg-amber-50 border border-alert/40 hover:bg-amber-100/60 transition-colors shadow-sm group"
            >
              <div class="w-11 h-11 rounded-xl bg-alert text-white flex items-center justify-center shrink-0" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div>
                <span class="text-xs text-amber-900 font-bold block">7/24 Acil Arıza Hattı</span>
                <strong class="text-base sm:text-lg font-bold text-navy-900 group-hover:text-amber-700 transition-colors block mt-0.5">
                  {company.emergencyPhone}
                </strong>
              </div>
            </a>
          </div>

          <!-- Office Details Card -->
          <div class="rounded-2xl bg-white p-6 border border-gray-200 text-xs sm:text-sm text-gray-700 space-y-3.5 shadow-sm">
            <div>
              <span class="text-xs text-gray-500 font-medium block">Merkez Ofis Adresi:</span>
              <strong class="text-navy-900 block mt-0.5">
                {company.address.street}, {company.address.district} / {company.address.city}
              </strong>
            </div>
            <div>
              <span class="text-xs text-gray-500 font-medium block">Kurumsal E-Posta:</span>
              <a href={`mailto:${company.email}`} class="text-brand-600 font-bold hover:underline block mt-0.5">
                {company.email}
              </a>
            </div>
            <div>
              <span class="text-xs text-gray-500 font-medium block">Çalışma Saatleri:</span>
              <span class="block mt-0.5">Hafta İçi: {company.workingHours.weekdays} | Cumartesi: {company.workingHours.saturday}</span>
            </div>
            <div>
              <span class="text-xs text-gray-500 font-medium block">Hizmet Verilen Bölgeler:</span>
              <span class="text-gray-600 block mt-0.5">{company.areaServed.join(', ')}</span>
            </div>
          </div>

        </aside>

        <!-- Lead Generation Form Container (7 cols on lg) -->
        <main class="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-10 border border-gray-200 shadow-sm">
          <header class="mb-6">
            <h2 class="text-2xl font-bold text-navy-900">Ücretsiz Keşif & Teklif Formu</h2>
            <p class="text-xs sm:text-sm text-gray-600 mt-1.5 leading-relaxed">
              Bilgilerinizi bırakın; mühendisimiz mekanınızı incelemek üzere en geç 1 iş saati içinde sizinle iletişime geçsin.
            </p>
          </header>

          <!-- Interactive Contact Form Component -->
          <ContactForm
            services={serviceOptions}
            whatsappRaw={company.whatsappRaw}
            client:load
          />
        </main>

      </div>
    </div>
  </section>

  <!-- Service Area & Regional Coverage Map Section -->
  <section class="py-14 sm:py-16 bg-white border-t border-gray-200" aria-label="Mobil Servis ve Hizmet Bölgelerimiz">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-8 max-w-3xl">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
          Mobil Servis Ağı & Kapsama Alanı
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 mt-1.5">
          İstanbul Geneli ve Çevre İllerde Yerinde Keşif & Montaj
        </h2>
        <p class="text-sm text-gray-600 mt-2 leading-relaxed">
          Mobil mühendislik ve montaj ekiplerimizle sabit bir adrese bağlı kalmadan; İstanbul'un tüm ilçelerine, Kocaeli, Tekirdağ ve Bursa sanayi & konut bölgelerine yerinde hizmet sağlıyoruz.
        </p>
      </header>

      <!-- Hizmet Bölgesi Rozetleri -->
      <div class="mb-6 flex flex-wrap gap-2">
        <span class="px-3 py-1.5 rounded-lg bg-brand-50 border border-brand-500/30 text-xs font-bold text-brand-700">
          ✓ İstanbul Anadolu Yakası (Tüm İlçeler)
        </span>
        <span class="px-3 py-1.5 rounded-lg bg-brand-50 border border-brand-500/30 text-xs font-bold text-brand-700">
          ✓ İstanbul Avrupa Yakası (Tüm İlçeler)
        </span>
        <span class="px-3 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-xs font-bold text-navy-900">
          ✓ Kocaeli & Gebze Sanayi Bölgesi
        </span>
        <span class="px-3 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-xs font-bold text-navy-900">
          ✓ Tekirdağ & Çorlu
        </span>
        <span class="px-3 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-xs font-bold text-navy-900">
          ✓ Bursa
        </span>
      </div>

      <div class="rounded-xl overflow-hidden border border-gray-200 shadow-sm h-[360px] sm:h-[420px] w-full bg-surface">
        <iframe
          title="Kale İklimlendirme İstanbul ve Marmara Hizmet Bölgesi Haritası"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d385396.32104523315!2d28.675095648834454!3d41.005500511674395!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caa7040068086b%3A0xe1ccfe98bc01b0d0!2zxLBzdGFuYnVs!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>
</MainLayout>

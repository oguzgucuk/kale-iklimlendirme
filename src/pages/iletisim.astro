---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
---

<MainLayout
  title={`İletişim & Ücretsiz Keşif | ${company.companyName}`}
  description="Kale İklimlendirme iletişim bilgileri, telefon, WhatsApp danışma hattı ve ücretsiz keşif talep formu."
>
  <div class="bg-navy-900 text-white py-16 border-b border-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold text-brand-400 uppercase tracking-widest">Bize Ulaşın</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold mt-2">İletişim & Ücretsiz Keşif</h1>
      <p class="text-gray-300 text-base max-w-2xl mt-3">
        Klima satışı, VRF merkezi sistem projelendirme ve acil arıza talepleriniz için uzman ekibimizle iletişime geçin.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Contact Information (5 Cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-navy-900">Doğrudan İletişim Hatları</h2>
          <p class="text-sm text-gray-600 mt-2">
            Çağrı merkezimiz mesai saatleri içinde anında, acil arıza ekibimiz 7/24 hizmetinizdedir.
          </p>
        </div>

        <div class="space-y-4">
          <!-- Main Phone -->
          <a
            href={`tel:${company.phoneRaw}`}
            class="flex items-start gap-4 p-4 rounded-xl bg-white border border-gray-200 hover:border-brand-500 transition-colors shadow-sm"
          >
            <div class="w-10 h-10 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-gray-500 font-medium">Santral & Müşteri Hizmetleri</div>
              <div class="text-lg font-bold text-navy-900">{company.phone}</div>
            </div>
          </a>

          <!-- WhatsApp -->
          <a
            href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-4 p-4 rounded-xl bg-[#25D366]/10 border border-[#25D366]/30 hover:bg-[#25D366]/20 transition-colors shadow-sm"
          >
            <div class="w-10 h-10 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.599 2.674-.7c.976.58 2.019.882 3.209.882h.001c3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.768-5.767-5.768zm3.366 8.163c-.141.397-.714.729-1.026.776-.29.043-.654.072-2.12-.533-1.875-.776-3.08-2.697-3.174-2.82-.093-.124-.764-1.018-.764-1.942 0-.923.483-1.378.654-1.564.171-.186.374-.233.499-.233.124 0 .249.002.358.007.115.006.269-.044.421.323.157.38.537 1.309.584 1.405.047.096.078.209.016.333-.063.125-.094.202-.187.311-.093.11-.197.246-.281.33-.094.094-.192.197-.082.386.11.189.489.808 1.05 1.307.722.643 1.33.842 1.519.935.188.094.3.078.411-.047.112-.125.48-559.608-.751.127-.192.256-.16.429-.096.173.064 1.096.517 1.284.611.188.094.313.141.359.219.047.078.047.452-.094.849zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.176L2 22l4.982-1.397A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-emerald-800 font-bold">WhatsApp Danışma Hattı</div>
              <div class="text-lg font-bold text-navy-900">{company.whatsappNumber}</div>
            </div>
          </a>

          <!-- Emergency 7/24 Phone -->
          <a
            href={`tel:${company.emergencyPhoneRaw}`}
            class="flex items-start gap-4 p-4 rounded-xl bg-amber-50 border border-alert/30 hover:bg-amber-100/50 transition-colors shadow-sm"
          >
            <div class="w-10 h-10 rounded-lg bg-alert text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-amber-800 font-bold">7/24 Nöbetçi Arıza Servisi</div>
              <div class="text-lg font-bold text-navy-900">{company.emergencyPhone}</div>
            </div>
          </a>
        </div>

        <!-- Address & Working hours -->
        <div class="bg-white rounded-xl p-5 border border-gray-200 text-sm space-y-3">
          <div>
            <span class="text-xs text-gray-500 block font-medium">Merkez Adres:</span>
            <strong class="text-navy-900">
              {company.address.street}, {company.address.district} / {company.address.city}
            </strong>
          </div>
          <div>
            <span class="text-xs text-gray-500 block font-medium">E-Posta:</span>
            <a href={`mailto:${company.email}`} class="text-brand-600 font-semibold hover:underline">
              {company.email}
            </a>
          </div>
          <div>
            <span class="text-xs text-gray-500 block font-medium">Çalışma Saatleri:</span>
            <span class="text-gray-700">Hafta içi: {company.workingHours.weekdays} | Cumartesi: {company.workingHours.saturday}</span>
          </div>
        </div>
      </div>

      <!-- Lead Gen Form (7 Cols) -->
      <div class="lg:col-span-7 bg-white rounded-2xl p-8 sm:p-10 border border-gray-200 shadow-sm">
        <h2 class="text-2xl font-bold text-navy-900 mb-2">Ücretsiz Keşif & Teklif Formu</h2>
        <p class="text-sm text-gray-600 mb-6">
          Formu doldurun, teknik ekibimiz en geç 1 iş saati içinde sizinle iletişime geçsin.
        </p>

        <form action="#" method="POST" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-semibold text-navy-900 mb-1">
                Adınız Soyadınız *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-500 focus:ring-brand-500"
                placeholder="Örn: Ahmet Yılmaz"
              />
            </div>
            <div>
              <label for="phone" class="block text-xs font-semibold text-navy-900 mb-1">
                Telefon Numaranız *
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-500 focus:ring-brand-500"
                placeholder="05XX XXX XX XX"
              />
            </div>
          </div>

          <div>
            <label for="service" class="block text-xs font-semibold text-navy-900 mb-1">
              İlgilendiğiniz Hizmet *
            </label>
            <select
              id="service"
              name="service"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-500 focus:ring-brand-500 bg-white"
            >
              <option value="">Lütfen seçiniz</option>
              {services.map((s) => (
                <option value={s.id}>{s.data.title}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold text-navy-900 mb-1">
              Proje / Talep Detayları
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:border-brand-500 focus:ring-brand-500"
              placeholder="Mekan türü (ev, ofis, otel), yaklaşık m² veya arıza detayını belirtiniz..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-xl shadow-md transition-all text-center"
          >
            Ücretsiz Keşif Talebini Gönder
          </button>
        </form>
      </div>

    </div>
  </div>
</MainLayout>

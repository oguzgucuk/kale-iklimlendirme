---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<MainLayout
  title={`Hizmetlerimiz | ${company.companyName}`}
  description="Klima satışı, VRF merkezi sistem projelendirme, arıza-bakım-onarım ve klima altyapı tesisatı."
>
  <div class="bg-navy-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold text-brand-400 uppercase tracking-widest">Çözümlerimiz</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold mt-2">Hizmetlerimiz</h1>
      <p class="text-gray-300 text-base max-w-2xl mt-3">
        Mühendislik temelli yaklaşımımızla konutlardan dev tesislere kadar tüm iklimlendirme ihtiyaçlarını karşılıyoruz.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((service) => (
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-navy-900">{service.data.title}</h2>
            <p class="text-gray-600 mt-3 leading-relaxed">{service.data.shortDescription}</p>
          </div>
          <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
            <a
              href={`/hizmetler/${service.id}`}
              class="inline-flex items-center gap-2 font-bold text-brand-600 hover:text-brand-700"
            >
              Hizmet Detayını İncele
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href="/iletisim"
              class="text-xs font-semibold text-navy-900 bg-surface px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-100"
            >
              Fiyat Teklifi Al
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</MainLayout>

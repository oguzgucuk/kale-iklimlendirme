---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<MainLayout
  title={`Hizmetlerimiz | ${company.companyName}`}
  description="Klima satışı, VRF merkezi sistem projelendirme, arıza-bakım-onarım ve klima altyapı tesisatı mühendisliği."
>
  <!-- Page Header -->
  <header class="bg-navy-900 text-white py-12 sm:py-16 border-b border-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Semantic Breadcrumb -->
      <nav aria-label="Erişim Yolu" class="mb-4">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-gray-400 list-none p-0 m-0">
          <li>
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li class="text-brand-400 font-semibold" aria-current="page">Hizmetlerimiz</li>
        </ol>
      </nav>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold mt-1.5 leading-tight text-white font-heading break-words">
        Hizmetlerimiz & Mühendislik Çözümlerimiz
      </h1>
      <p class="text-sm sm:text-base text-gray-300 max-w-2xl mt-3 leading-relaxed">
        Bireysel konutlardan plazalara, otellerden sanayi tesislerine kadar her yapının ihtiyacına özel, enerji verimli ve garantili iklimlendirme sistemleri tasarlıyoruz.
      </p>
    </div>
  </header>

  <!-- Main Content: Services Grid -->
  <section class="py-16 sm:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <header class="max-w-3xl mb-10 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 leading-tight font-heading">
          Uzmanlık Alanlarımız
        </h2>
        <p class="text-sm sm:text-base text-gray-600 mt-2">
          İhtiyacınıza en uygun hizmeti seçerek detaylı teknik kapsamı ve uygulama standartlarımızı inceleyebilirsiniz.
        </p>
      </header>

      <!-- Services Grid: Mobile 1 col, Tablet 2 col, Desktop 4 col -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service) => (
          <ServiceCard
            title={service.data.title}
            shortDescription={service.data.shortDescription}
            slug={service.id}
            icon={service.data.icon}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- Engineering Guarantee Highlight Section -->
  <section class="py-16 sm:py-20 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <article class="p-6 rounded-xl bg-slate-50/70 border border-gray-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="h-2 w-2 rounded-full bg-brand-500"></span>
            <span class="text-xs font-mono font-bold text-slate-400">STANDART 01</span>
          </div>
          <h3 class="text-lg font-bold text-navy-950 mb-2 font-heading">Doğru Kapasite Analizi</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Ezbere cihaz seçimi yüksek elektrik faturası ve yetersiz soğutma getirir. Termal yük hesabı ile tam ihtiyaç duyulan kapasiteyi belirliyoruz.
          </p>
        </article>

        <article class="p-6 rounded-xl bg-slate-50/70 border border-gray-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="h-2 w-2 rounded-full bg-brand-500"></span>
            <span class="text-xs font-mono font-bold text-slate-400">STANDART 02</span>
          </div>
          <h3 class="text-lg font-bold text-navy-950 mb-2 font-heading">Sertifikalı Uygulama</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Azot sızdırmazlık testleri ve derin vakum prosedürleri uygulanarak cihazların kompresör ömrü ve fabrika verimliliği korunur.
          </p>
        </article>

        <article class="p-6 rounded-xl bg-slate-50/70 border border-gray-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="h-2 w-2 rounded-full bg-brand-500"></span>
            <span class="text-xs font-mono font-bold text-slate-400">STANDART 03</span>
          </div>
          <h3 class="text-lg font-bold text-navy-950 mb-2 font-heading">Orijinal Parça & 7/24 Destek</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Yetkili bayiliklerimiz sayesinde tüm yedek parça ve montaj malzemeleri %100 orijinal ve üretici garantili olarak temin edilir.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CtaBanner />
</MainLayout>

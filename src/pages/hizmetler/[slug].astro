---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const allServices = await getCollection('services');
const otherServices = allServices.filter((s) => s.id !== service.id);

const allProjects = await getCollection('projects');
const matchingProjects = allProjects
  .filter((p) => {
    const text = (p.data.systemType + ' ' + p.id + ' ' + p.data.summary).toLowerCase();
    if (service.id === 'vrf-merkezi-sistem-projelendirme') {
      return text.includes('vrf') || text.includes('vrv') || text.includes('multi');
    }
    if (service.id === 'ariza-bakim-onarim') {
      return text.includes('arıza') || text.includes('bakım') || text.includes('onar') || text.includes('kaçak') || text.includes('şarj');
    }
    if (service.id === 'klima-altyapi') {
      return text.includes('altyapı') || text.includes('şantiye') || text.includes('borulama');
    }
    if (service.id === 'klima-satisi') {
      return text.includes('satış') || text.includes('montaj') || text.includes('split') || text.includes('kaset') || text.includes('salon');
    }
    return false;
  })
  .slice(0, 3);

const customWhatsAppMessage = `Merhaba, ${service.data.title} hizmetiniz hakkında detaylı bilgi ve ücretsiz keşif talep etmek istiyorum.`;

const serviceUrl = `https://kaleiklimlendirme.com/hizmetler/${service.id}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      name: service.data.title,
      description: service.data.shortDescription,
      serviceType: service.data.title,
      provider: {
        '@type': 'HVACBusiness',
        name: company.companyName,
        telephone: company.phone,
        email: company.email,
        url: 'https://kaleiklimlendirme.com/',
      },
      areaServed: company.areaServed.map((area) => ({
        '@type': 'AdministrativeArea',
        name: area,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Ana Sayfa',
          item: 'https://kaleiklimlendirme.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Hizmetlerimiz',
          item: 'https://kaleiklimlendirme.com/hizmetler/',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: service.data.title,
          item: serviceUrl,
        },
      ],
    },
  ],
};
---

<MainLayout
  title={`${service.data.title} | ${company.companyName}`}
  description={service.data.shortDescription}
  customWhatsAppMessage={customWhatsAppMessage}
  structuredData={structuredData}
>
  <!-- Semantic Page Header -->
  <header class="bg-navy-900 text-white py-12 sm:py-16 border-b border-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Semantic Breadcrumb -->
      <nav aria-label="Erişim Yolu" class="mb-4">
        <ol class="flex items-center gap-2 text-xs text-gray-400 list-none p-0 m-0">
          <li>
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li>
            <a href="/hizmetler/" class="hover:text-white transition-colors">Hizmetlerimiz</a>
          </li>
          <li aria-hidden="true" class="text-gray-600">/</li>
          <li class="text-brand-400 font-semibold" aria-current="page">{service.data.title}</li>
        </ol>
      </nav>

      <span class="text-xs font-bold text-brand-400 uppercase tracking-widest block">
        Teknik Hizmet Kapsamı
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mt-1.5 leading-tight">
        {service.data.title}
      </h1>
      <p class="text-sm sm:text-base text-gray-300 max-w-2xl mt-3 leading-relaxed">
        {service.data.shortDescription}
      </p>
    </div>
  </header>

  <!-- Page Content: Article & Sidebar (Mobile-First) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- Main Content Article (8 cols on lg) -->
      <article class="lg:col-span-8 bg-white rounded-2xl p-6 sm:p-10 border border-gray-200/90 shadow-sm">
        <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-navy-900 prose-h2:text-2xl prose-h2:border-b prose-h2:border-gray-100 prose-h2:pb-3 prose-h3:text-lg prose-p:text-gray-700 prose-p:leading-relaxed prose-li:text-gray-700 prose-a:text-brand-600">
          <Content />
        </div>

        <!-- In-Article Lead Action Card -->
        <aside class="mt-10 rounded-xl bg-surface border border-gray-200 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-5" aria-label="Keşif Talebi">
          <div class="space-y-1 text-center sm:text-left">
            <h2 class="text-xl font-bold text-navy-900">Bu Hizmet İçin Keşif İsteyin</h2>
            <p class="text-xs sm:text-sm text-gray-600">
              Mühendislerimiz projenizi yerinde incelesin, en uygun kapasite ve maliyet tablosunu çıkarsın.
            </p>
          </div>
          <a
            href="/iletisim/"
            class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand-500 text-white font-bold text-sm hover:bg-brand-600 transition-colors shadow-sm"
          >
            Ücretsiz Keşif Formu
          </a>
        </aside>
      </article>

      <!-- Sidebar (4 cols on lg) -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Direct Quick Call Card -->
        <div class="rounded-xl bg-navy-900 text-white p-6 sm:p-7 space-y-4 border border-navy-950 shadow-md">
          <span class="text-xs font-bold text-brand-400 uppercase tracking-wider block">
            Hızlı Teknik Danışma
          </span>
          <h2 class="text-xl font-bold leading-snug">
            Sorularınız İçin Uzman Mühendisimizle Görüşün
          </h2>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Mesai saatleri içinde doğrudan telefon hattımızdan veya WhatsApp üzerinden anında bilgi alabilirsiniz.
          </p>

          <div class="pt-2 space-y-2.5">
            <a
              href={`tel:${company.phoneRaw}`}
              class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-white text-navy-900 font-bold text-sm hover:bg-gray-100 transition-colors"
            >
              <svg class="h-4 w-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{company.phone}</span>
            </a>

            <a
              href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(customWhatsAppMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#25D366] text-white font-bold text-sm hover:bg-[#20bd5a] transition-colors"
            >
              <span>WhatsApp'tan Danışın</span>
            </a>
          </div>
        </div>

        <!-- Related Case Studies / Saha Referansları -->
        {matchingProjects.length > 0 && (
          <div class="rounded-2xl bg-white p-6 border border-gray-200 shadow-sm space-y-3.5">
            <div class="flex items-center justify-between pb-2 border-b border-gray-100">
              <h2 class="text-base font-bold text-navy-900">
                Saha Referanslarımız
              </h2>
              <a
                href="/projeler/"
                class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-0.5"
              >
                <span>Tümü</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <div class="space-y-3">
              {matchingProjects.map((proj) => (
                <a
                  href={`/projeler/${proj.id}/`}
                  class="group flex items-start gap-3 p-2 rounded-xl hover:bg-surface transition-colors"
                >
                  {proj.data.coverImage && (
                    <div class="w-16 h-12 rounded-lg overflow-hidden shrink-0 bg-navy-950/10">
                      <img
                        src={proj.data.coverImage}
                        alt={proj.data.title}
                        class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="flex-1 min-w-0">
                    <h3 class="text-xs font-bold text-navy-900 group-hover:text-brand-600 line-clamp-2 leading-snug">
                      {proj.data.title}
                    </h3>
                    <div class="text-[11px] text-gray-500 mt-0.5 truncate">{proj.data.location}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Other Services List -->
        <nav aria-label="Diğer Hizmetler" class="rounded-2xl bg-white p-6 border border-gray-200 shadow-sm">
          <h2 class="text-base font-bold text-navy-900 mb-4 pb-2 border-b border-gray-100">
            Diğer Hizmetlerimiz
          </h2>
          <ul class="space-y-2 list-none p-0 m-0">
            {otherServices.map((s) => (
              <li>
                <a
                  href={`/hizmetler/${s.id}/`}
                  class="flex items-center justify-between py-2 text-sm font-medium text-gray-700 hover:text-brand-600 transition-colors"
                >
                  <span>{s.data.title}</span>
                  <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Working Hours Info -->
        <div class="rounded-2xl bg-white p-6 border border-gray-200 shadow-sm text-xs text-gray-600 space-y-2">
          <div class="font-bold text-navy-900 text-sm">Çalışma Saatleri</div>
          <div>Hafta İçi: <strong class="text-navy-900">{company.workingHours.weekdays}</strong></div>
          <div>Cumartesi: <strong class="text-navy-900">{company.workingHours.saturday}</strong></div>
          <div class="text-alert font-semibold pt-1">
            7/24 Acil Müdahale Ekibi Aktif
          </div>
        </div>

      </aside>

    </div>
  </div>
</MainLayout>

---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<MainLayout
  title={`${service.data.title} | ${company.companyName}`}
  description={service.data.shortDescription}
>
  <!-- Page Header -->
  <div class="bg-navy-900 text-white py-14 border-b border-navy-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-gray-400 mb-4">
        <a href="/" class="hover:text-white">Ana Sayfa</a>
        <span>/</span>
        <a href="/hizmetler" class="hover:text-white">Hizmetlerimiz</a>
        <span>/</span>
        <span class="text-brand-400 font-medium">{service.data.title}</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight">
        {service.data.title}
      </h1>
      <p class="text-gray-300 text-base mt-3 leading-relaxed">
        {service.data.shortDescription}
      </p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <article class="prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:text-navy-900 prose-h2:text-2xl prose-h3:text-xl prose-a:text-brand-600">
      <Content />
    </article>

    <!-- Contextual Lead-Gen CTA Card -->
    <div class="mt-14 bg-navy-900 text-white rounded-2xl p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="space-y-2 text-center sm:text-left">
        <h3 class="text-2xl font-bold text-white">Bu Hizmet İçin Keşif ve Teklif Alın</h3>
        <p class="text-sm text-gray-300 max-w-md">
          Mühendislerimiz projenizi incelesin, mekanınıza en uygun kapasite ve maliyet analizini çıkarsın.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <a
          href="/iletisim"
          class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-xl transition-all shadow-md text-center"
        >
          Ücretsiz Keşif İste
        </a>
        <a
          href={`tel:${company.phoneRaw}`}
          class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold text-white bg-navy-950 hover:bg-navy-950/80 rounded-xl border border-gray-700 transition-all text-center"
        >
          {company.phone}
        </a>
      </div>
    </div>
  </div>
</MainLayout>

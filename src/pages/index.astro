---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { getCollection } from 'astro:content';

import HeroSection from '@/components/sections/HeroSection.astro';
import BrandRibbon from '@/components/sections/BrandRibbon.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import WhyUsSection from '@/components/sections/WhyUsSection.astro';
import ProjectsShowcase from '@/components/sections/ProjectsShowcase.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import TestimonialsSection from '@/components/sections/TestimonialsSection.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { FaqAccordion } from '@/components/ui/FaqAccordion';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects')).filter((p) => p.data.featured);
const testimonials = await getCollection('testimonials');
---

<MainLayout
  title={`${company.companyName} | VRF Merkezi Sistemler & Klima Satış Servis`}
  description={company.description}
>
  <!-- 1. Hero Section -->
  <HeroSection />

  <!-- 1.5 Brand Trust Ribbon (Gree, Midea, Samsung, Daikin, Arçelik, Mitsubishi) -->
  <BrandRibbon />

  <!-- 2. Services Grid Section -->
  <ServicesGrid services={services} />

  <!-- 3. Why Us / Trust Factors Section -->
  <WhyUsSection />

  <!-- 4. Featured Projects Showcase -->
  <ProjectsShowcase projects={featuredProjects} />

  <!-- 5. Process Steps (How We Work) -->
  <ProcessSteps />

  <!-- 6. Testimonials Section -->
  <TestimonialsSection testimonials={testimonials} />

  <!-- 7. FAQ Section with shadcn Accordion -->
  <section class="py-14 sm:py-20 bg-surface border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-10 sm:mb-12">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest block">
          Merak Edilenler
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-navy-900 mt-1.5 leading-tight">
          Sıkça Sorulan Sorular
        </h2>
        <p class="text-sm sm:text-base text-gray-600 mt-2">
          VRF merkezi sistemler ve iklimlendirme süreçlerimiz hakkında bilmeniz gerekenler.
        </p>
      </header>

      <div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm">
        <FaqAccordion client:visible />
      </div>
    </div>
  </section>

  <!-- 8. CTA Banner -->
  <CtaBanner />
</MainLayout>

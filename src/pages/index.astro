---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects')).filter((p) => p.data.featured);
const testimonials = await getCollection('testimonials');
---

<MainLayout
  title={`${company.companyName} | VRF Merkezi Sistemler & Klima Satış Servis`}
  description={company.description}
>
  <!-- Hero Section Preview (Faz 1 İskelet) -->
  <section class="relative bg-navy-900 text-white overflow-hidden py-20 lg:py-28 border-b border-navy-950">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#0EA5B7_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        
        <!-- Trust badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-navy-950 border border-brand-500/30 text-xs font-semibold text-brand-300">
          <span class="w-2 h-2 rounded-full bg-brand-400"></span>
          Yetkili VRF ve Kurumsal İklimlendirme Mühendisliği
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Klima Satışından <span class="text-brand-400">VRF Merkezi Sistem</span> Projelendirmeye Uçtan Uca Çözüm.
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 leading-relaxed max-w-2xl font-normal">
          Ev, ofis ve büyük ölçekli ticari binalar için doğru kapasite hesabı, profesyonel montaj, 
          7/24 kesintisiz arıza servisi ve periyodik hijyenik bakım hizmetleri.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/iletisim"
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-xl shadow-md transition-all transform hover:-translate-y-0.5 focus:ring-4 focus:ring-brand-500/40"
          >
            Ücretsiz Keşif Talebi
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={`tel:${company.phoneRaw}`}
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-bold text-white bg-navy-950 hover:bg-navy-950/80 rounded-xl border border-gray-700 transition-all gap-2"
          >
            <svg class="w-5 h-5 text-alert" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Hemen Arayın: {company.phone}
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="pt-8 grid grid-cols-2 sm:grid-cols-3 gap-6 border-t border-gray-800/80">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-brand-400">15+ Yıl</div>
            <div class="text-xs sm:text-sm text-gray-400 font-medium">Sektörel Mühendislik Deneyimi</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white">450+</div>
            <div class="text-xs sm:text-sm text-gray-400 font-medium">Tamamlanan VRF & Kurumsal Proje</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-alert">7/24</div>
            <div class="text-xs sm:text-sm text-gray-400 font-medium">Acil Arıza Müdahale Desteği</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4 Core Services Overview -->
  <section class="py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest">Hizmetlerimiz</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 mt-1">
          Bireysel ve Endüstriyel İklimlendirme Çözümleri
        </h2>
        <p class="text-base text-gray-600 mt-3">
          Mekanınızın mimari yapısına en uygun iklimlendirme sistemini projelendiriyor, garantili olarak devreye alıyoruz.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service) => (
          <div class="bg-white rounded-2xl p-6 border border-gray-200/90 shadow-sm hover:shadow-md hover:border-brand-500/40 transition-all flex flex-col justify-between group">
            <div>
              <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-lg mb-5 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                <!-- Service Icon representation -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>

              <h3 class="text-lg font-bold text-navy-900 group-hover:text-brand-600 transition-colors">
                {service.data.title}
              </h3>

              <p class="text-sm text-gray-600 mt-2.5 leading-relaxed">
                {service.data.shortDescription}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
              <a
                href={`/hizmetler/${service.id}`}
                class="text-xs font-bold text-navy-900 group-hover:text-brand-600 inline-flex items-center gap-1 transition-colors"
              >
                Detaylı Bilgi
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Featured Projects Preview -->
  <section class="py-20 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold text-brand-600 uppercase tracking-widest">Referanslarımız</span>
          <h2 class="text-3xl font-extrabold text-navy-900 mt-1">
            Öne Çıkan VRF & Kurumsal Projeler
          </h2>
        </div>
        <a
          href="/projeler"
          class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700"
        >
          Tüm Projeleri İncele
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project) => (
          <div class="bg-surface rounded-2xl p-7 border border-gray-200 hover:border-brand-500/40 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
                <span class="font-semibold text-brand-700 bg-brand-50 px-2.5 py-1 rounded">
                  {project.data.client}
                </span>
                <span>{project.data.location}</span>
              </div>
              <h3 class="text-xl font-bold text-navy-900">
                {project.data.title}
              </h3>
              <p class="text-sm text-gray-600 mt-3 leading-relaxed">
                {project.data.summary}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-gray-200 flex items-center justify-between text-xs text-gray-500 font-medium">
              <span>Sistem: <strong class="text-navy-900">{project.data.systemType}</strong></span>
              <a href={`/projeler/${project.id}`} class="font-bold text-brand-600 hover:underline">
                İncele &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Banner Section -->
  <section class="py-16 bg-navy-900 text-white border-t border-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
        Projeniz İçin Doğru İklimlendirme Kapasitesini Belirleyelim
      </h2>
      <p class="text-base text-gray-300 max-w-2xl mx-auto">
        Mühendislerimiz mekanınızı yerinde incelesin, en verimli klima ve VRF merkezi sistem teklifini ücretsiz sunsun.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-4">
        <a
          href="/iletisim"
          class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-white bg-brand-500 hover:bg-brand-600 rounded-xl shadow-md transition-all"
        >
          Hemen Keşif Talep Edin
        </a>
        <a
          href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent(company.defaultWhatsAppMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-white bg-[#25D366] hover:bg-[#20bd5a] rounded-xl shadow-md transition-all gap-2"
        >
          WhatsApp ile Hızlı Mesaj
        </a>
      </div>
    </div>
  </section>
</MainLayout>

---
import MainLayout from '@/layouts/MainLayout.astro';
import company from '@/data_files/company.json';
---

<MainLayout
  title={`Sayfa Bulunamadı (404) | ${company.companyName}`}
  description="Aradığınız sayfa silinmiş veya taşınmış olabilir."
  noindex={true}
>
  <main class="min-h-[65vh] flex items-center justify-center py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md text-center space-y-6">
      <span class="text-7xl sm:text-8xl font-black text-brand-500 font-mono tracking-tight block">
        404
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-navy-900 leading-tight">
        Sayfa Bulunamadı
      </h1>
      <p class="text-sm text-gray-600 leading-relaxed">
        Ulaşmaya çalıştığınız sayfa adresi değiştirilmiş veya yayından kaldırılmış olabilir. Ana sayfaya dönebilir veya doğrudan müşteri temsilcimizle iletişime geçebilirsiniz.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-navy-900 hover:bg-navy-950 rounded-xl transition-all shadow-sm"
        >
          Ana Sayfaya Dön
        </a>
        <a
          href="/hizmetler"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded-xl transition-all border border-brand-200"
        >
          Hizmetlerimizi İnceleyin
        </a>
      </div>

      <div class="pt-4 text-xs text-gray-500">
        Acil bir arıza durumunda mısınız? 
        <a href={`tel:${company.emergencyPhoneRaw}`} class="font-bold text-alert hover:underline block sm:inline mt-1 sm:mt-0">
          {company.emergencyPhone}
        </a>
      </div>
    </div>
  </main>
</MainLayout>

# 1. E-Posta Bildirim Servisi (Web3Forms)
# https://web3forms.com adresinden ücretsiz edinebilirsiniz (formlar Kadirkale1201@gmail.com adresine düşer)
PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# 2. WhatsApp Arka Plan Otomatik Bildirim Seçenekleri (Kullanıcı sitede kalır, WhatsApp açılmaz)
# Seçenek A: CallMeBot WhatsApp API (Ücretsiz & Hızlı Kurulum)
# WhatsApp'tan "+34 644 44 22 22" veya "+34 644 76 66 43" numarasına "I allow callmebot to send me messages" yazın.
# Size gelen apikey değerini buraya girin:
PUBLIC_CALLMEBOT_API_KEY=
PUBLIC_CALLMEBOT_PHONE=905537331201

# Seçenek B: Özel Webhook (Make.com, Zapier, UltraMsg, Green-API vb.)
# Belirlenen formatta WhatsApp mesajı ve form verisi buraya otomatik POST edilir:
PUBLIC_WHATSAPP_WEBHOOK_URL=

# 3. Google Analytics & Google Ads / Tag Manager (Opsiyonel - Reklam ve Ziyaretçi Takibi)
# Google Analytics 4 Ölçüm Kimliği (Örn: G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Veya Google Tag Manager Konteyner Kimliği (Örn: GTM-XXXXXXX)
PUBLIC_GTM_ID=

